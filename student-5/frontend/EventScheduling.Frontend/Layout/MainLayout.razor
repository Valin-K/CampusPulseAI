@inherits LayoutComponentBase
@inject CurrentUser CurrentUser
@inject CampusAccountService Account

<CampusShell PageName="Event &amp; Facility Scheduling"
             SectionLabel="Campus scheduling"
             UserName="@(Account.CurrentUser?.FullName ?? "Event Scheduling")"
             UserDetails="@(Account.CurrentUser is null ? "Scheduling workspace" : $"{Account.CurrentUser.Role} · {Account.CurrentUser.ExternalId}")"
             UserInitials="@(Account.CurrentUser?.Initials ?? "ES")"
             HomeHref="http://localhost:8080"
             RequireSignedInUser="true">
    <ChildContent>
        @Body
    </ChildContent>
</CampusShell>

@if (Account.CurrentUser is not null)
{
    <AssistantWidget />
    <CampusAiChat />
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await Account.InitializeAsync();
        await CurrentUser.LoadAsync();
    }
}
