@page "/"
@inject EventSchedulingApiClient Api
@inject NavigationManager Nav

<PageTitle>Event & Facility Scheduling</PageTitle>

<header class="dashboard-hero">
    <div>
        <span class="eyebrow">Your campus workspace</span>
        <h1>Book rooms. Hire gear. Stay on schedule.</h1>
        <p>Reserve study rooms, hire equipment, and keep track of everything you've already booked.</p>
    </div>
    <div class="term-summary">
        <span>Current profile</span>
        <strong>Jordan Lee</strong>
        <small>Student ID 5</small>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="notice notice-error" role="alert">@errorMessage</div>
}

<section class="surface-card" aria-label="Bookings needing your attention" style="margin: 1.25rem 0">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Today at a glance</span>
            <h2>Today's schedule</h2>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="skeleton-stack"><span></span><span></span><span></span></div>
    }
    else if (DashboardBookings.Count == 0)
    {
        <p class="eyebrow">Nothing overdue, active, or scheduled for today.</p>
    }
    else
    {
        <div class="booking-strip" role="list" aria-label="Priority bookings">
            @foreach (var entry in DashboardBookings)
            {
                <article class="booking-strip-card" role="listitem">
                    <div class="booking-strip-topline">
                        <span class="status-badge @entry.BadgeClass">@entry.BadgeLabel</span>
                        <span class="booking-strip-kind">@(entry.Booking.ResourceType == ResourceType.Room ? "Room" : "Equipment")</span>
                    </div>
                    <h3>@entry.Booking.ResourceName</h3>
                    <p class="booking-strip-meta">@entry.TimeText</p>
                </article>
            }
        </div>
    }
</section>

<section class="surface-card" aria-label="Reserve or hire">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Get started</span>
            <h2>What do you need today?</h2>
        </div>
    </div>
    <div class="card-grid">
        <button type="button" class="resource-tile" @onclick="@(() => Nav.NavigateTo("/search?type=room"))">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <rect x="3" y="4" width="18" height="16" rx="2" />
                <path d="M3 9h18M8 4v5" />
            </svg>
            <strong>Reserve a study room</strong>
            <span>Browse rooms by location and capacity</span>
        </button>
        <button type="button" class="resource-tile" @onclick="@(() => Nav.NavigateTo("/search?type=equipment"))">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <rect x="2" y="6" width="20" height="12" rx="2" />
                <circle cx="12" cy="12" r="3" />
            </svg>
            <strong>Hire equipment</strong>
            <span>Cameras, adapters, projectors, and more</span>
        </button>
    </div>
</section>

<section class="surface-card" aria-label="My schedule">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Your calendar</span>
            <h2>My schedule</h2>
        </div>
        <button type="button" class="button button-secondary" @onclick="@(() => Nav.NavigateTo("/calendar"))">View full calendar</button>
    </div>
    @if (isLoading)
    {
        <div class="skeleton-stack"><span></span><span></span><span></span></div>
    }
    else
    {
        <BookingCalendar Bookings="myBookings" AnchorDate="anchorDate" ViewMode="month" MaxBookingsPerDay="2" ShowNavigation="false" OnDateSelected="GoToBooking" />
    }
</section>

@code {
    private const int StudentId = 5;
    private readonly List<BookingResponse> myBookings = [];
    private readonly DateOnly anchorDate = DateOnly.FromDateTime(DateTime.Today);
    private string? errorMessage;
    private bool isLoading = true;

    private List<DashboardEntry> DashboardBookings => BuildDashboard();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var bookings = await Api.GetBookingsAsync();
            myBookings.Clear();
            myBookings.AddRange(bookings.Where(booking => booking.StudentId == StudentId));
        }
        catch (HttpRequestException)
        {
            errorMessage = "The Event Scheduling service is unavailable.";
        }
        finally
        {
            isLoading = false;
        }
    }

    // Cards shown on the dashboard, ordered by priority: overdue equipment first (shown until
    // returned, any date), then bookings active right now, then bookings still to start today.
    private List<DashboardEntry> BuildDashboard()
    {
        var now = DateTime.UtcNow;
        var today = DateOnly.FromDateTime(now);
        var entries = new List<DashboardEntry>();

        foreach (var booking in myBookings)
        {
            if (booking.Status == BookingStatus.Overdue)
            {
                entries.Add(new DashboardEntry(booking, DashboardCategory.Overdue));
                continue;
            }

            if (booking.Status is not (BookingStatus.Pending or BookingStatus.Confirmed))
            {
                continue;
            }

            if (now >= booking.StartUtc && now < booking.EndUtc)
            {
                entries.Add(new DashboardEntry(booking, DashboardCategory.Active));
            }
            else if (now < booking.StartUtc && DateOnly.FromDateTime(booking.StartUtc) == today)
            {
                entries.Add(new DashboardEntry(booking, DashboardCategory.Upcoming));
            }
        }

        return entries
            .OrderBy(entry => (int)entry.Category)
            .ThenBy(entry => entry.Category == DashboardCategory.Overdue ? entry.Booking.EndUtc : entry.Booking.StartUtc)
            .ToList();
    }

    private void GoToBooking(DateOnly date) => Nav.NavigateTo($"/book?date={date:yyyy-MM-dd}");

    private enum DashboardCategory
    {
        Overdue,
        Active,
        Upcoming
    }

    private sealed record DashboardEntry(BookingResponse Booking, DashboardCategory Category)
    {
        public string BadgeClass => Category switch
        {
            DashboardCategory.Overdue => "overdue",
            DashboardCategory.Active => "paid",
            _ => "outstanding"
        };

        public string BadgeLabel => Category switch
        {
            DashboardCategory.Overdue => "Overdue",
            DashboardCategory.Active => "Active now",
            _ => "Upcoming today"
        };

        public string TimeText => Category switch
        {
            DashboardCategory.Overdue => $"Was due {Booking.EndUtc:MMM d, h:mm tt}",
            DashboardCategory.Active => $"Ends {Booking.EndUtc:h:mm tt}",
            _ => $"Starts {Booking.StartUtc:h:mm tt}"
        };
    }
}
