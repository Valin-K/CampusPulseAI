@namespace EventScheduling.Frontend.Components

<div class="assistant-dock">
    <aside class="assistant-drawer @(isOpen ? "is-open" : null)"
           aria-hidden="@((!isOpen).ToString().ToLowerInvariant())">
        <header class="assistant-drawer-head">
            <div>
                <span class="assistant-drawer-eyebrow">Scheduling assistant</span>
                <strong>Rooms, equipment &amp; your bookings</strong>
            </div>
            <button type="button" class="assistant-drawer-min" @onclick="Close" aria-label="Minimise assistant">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" />
                </svg>
            </button>
        </header>
        <div class="assistant-drawer-body">
            <BookingAssistant />
        </div>
    </aside>

    @if (!isOpen)
    {
        <button type="button" class="assistant-fab" @onclick="Open"
                aria-label="Open the scheduling assistant">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-3.8-.9L3 21l1.9-5.7A8.5 8.5 0 1 1 21 11.5z" />
                <circle cx="8.5" cy="12" r="1" fill="currentColor" stroke="none" />
                <circle cx="12" cy="12" r="1" fill="currentColor" stroke="none" />
                <circle cx="15.5" cy="12" r="1" fill="currentColor" stroke="none" />
            </svg>
            <span class="assistant-fab-text">Assistant</span>
        </button>
    }
</div>

@code {
    private bool isOpen;

    private void Open() => isOpen = true;
    private void Close() => isOpen = false;
}
