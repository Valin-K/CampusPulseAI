server {
    listen       80;
    listen  [::]:80;
    server_name  localhost;

    root   /usr/share/nginx/html;
    index  index.html;

    # Proxies API calls to the backend so the browser only ever talks to this
    # frontend's own origin. BACKEND_HOST is the backend's cloud/compose
    # service name; it is substituted in by the nginx image's built-in
    # envsubst templating at container start. The backend is resolved via a
    # variable (not a bare proxy_pass host) so nginx defers DNS lookup to
    # request time instead of crashing at startup if the backend isn't
    # resolvable yet (e.g. during a cold start).
    resolver 127.0.0.11 valid=10s;

    location /api/ {
        # proxy_pass with a variable disables nginx's normal location-prefix
        # URI rewriting, so the upstream URL is built explicitly from the
        # original request URI (path + query string) instead of relying on
        # an implicit rewrite.
        set $backend_upstream http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_pass $backend_upstream$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /_framework/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location /js/ {
        add_header Cache-Control "no-cache";
    }
}
