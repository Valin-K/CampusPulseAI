@page "/courses/new"
@page "/courses/{Id:int}/edit"
@inject CourseApiClient CourseApi
@inject NavigationManager Navigation

<PageTitle>@(IsEdit ? "Edit Course" : "Create Course")</PageTitle>

<h1>@(IsEdit ? "Edit Course" : "Create Course")</h1>

@if (isLoading)
{
    <LoadingIndicator Message="Loading Course..." />
}
else if (loadFailed)
{
    <FeedbackPanel Kind="FeedbackKind.Error"
                   Title="Course form could not be loaded"
                   Message="@(errorMessage ?? "The Course form could not be loaded.")">
        <NavLink class="btn btn-outline-danger" href="courses">Back to Courses</NavLink>
    </FeedbackPanel>
}
else
{
    @if (errorMessage is not null)
    {
        <FeedbackPanel Kind="FeedbackKind.Error"
                       Title="Course could not be saved"
                       Message="@errorMessage" />
    }

    @if (isSaving)
    {
        <LoadingIndicator Message="Saving Course..." />
    }

    <EditForm Model="@courseForm"
              OnValidSubmit="SaveAsync"
              FormName="course-form"
              aria-busy="@isSaving">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label" for="course-code">Course code</label>
            <InputText id="course-code" class="form-control" @bind-Value="courseForm.Code" />
            <ValidationMessage For="@(() => courseForm.Code)" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="course-name">Course name</label>
            <InputText id="course-name" class="form-control" @bind-Value="courseForm.Name" />
            <ValidationMessage For="@(() => courseForm.Name)" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="course-description">Description</label>
            <InputTextArea id="course-description"
                           class="form-control"
                           rows="5"
                           @bind-Value="courseForm.Description" />
            <ValidationMessage For="@(() => courseForm.Description)" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label" for="course-credit-points">Credit points</label>
                <InputNumber id="course-credit-points"
                             class="form-control"
                             min="0"
                             max="48"
                             step="1"
                             @bind-Value="courseForm.CreditPoints" />
                <ValidationMessage For="@(() => courseForm.CreditPoints)" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label" for="course-level">Level</label>
                <InputNumber id="course-level"
                             class="form-control"
                             min="0"
                             max="10"
                             step="1"
                             @bind-Value="courseForm.Level" />
                <ValidationMessage For="@(() => courseForm.Level)" />
            </div>
        </div>

        <div class="form-check mb-3">
            <InputCheckbox id="course-active"
                           class="form-check-input"
                           @bind-Value="courseForm.IsActive" />
            <label class="form-check-label" for="course-active">Course is active</label>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary" type="submit" disabled="@isSaving">
                @(isSaving ? "Saving..." : "Save Course")
            </button>
            <NavLink class="btn btn-outline-secondary" href="@CancelUrl">Cancel</NavLink>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private CourseFormModel courseForm = new();
    private string? errorMessage;
    private bool isLoading;
    private bool isSaving;
    private bool loadFailed;

    private bool IsEdit => Id > 0;
    private string CancelUrl => IsEdit ? $"/courses/{Id}" : "/courses";

    protected override async Task OnParametersSetAsync()
    {
        errorMessage = null;
        loadFailed = false;

        if (!IsEdit)
        {
            courseForm = new CourseFormModel();
            isLoading = false;
            return;
        }

        isLoading = true;

        try
        {
            var course = await CourseApi.GetByIdAsync(Id);
            courseForm = CourseFormModel.FromCourse(course);
        }
        catch (CourseApiException exception)
        {
            errorMessage = exception.Message;
            loadFailed = true;
        }
        catch (HttpRequestException)
        {
            errorMessage = "The Course could not be loaded. Check that the API is running.";
            loadFailed = true;
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage = "The Course was returned in an unexpected format.";
            loadFailed = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            var course = IsEdit
                ? await CourseApi.UpdateAsync(Id, courseForm)
                : await CourseApi.CreateAsync(courseForm);

            var message = IsEdit ? "updated" : "created";
            Navigation.NavigateTo($"/courses/{course.Id}?message={message}");
        }
        catch (CourseApiException exception)
        {
            errorMessage = exception.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "The Course could not be saved. Check that the API is running.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage = "The Course API returned an unexpected response.";
        }
        finally
        {
            isSaving = false;
        }
    }
}
