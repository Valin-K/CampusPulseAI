@page "/courses/{Id:int}"
@inject CourseApiClient CourseApi
@inject NavigationManager Navigation
@inject IJSRuntime JavaScript

<PageTitle>Course details</PageTitle>

@if (isLoading)
{
    <LoadingIndicator Message="Loading Course details..." />
}
else if (loadFailed)
{
    <FeedbackPanel Kind="FeedbackKind.Error"
                   Title="Course details could not be loaded"
                   Message="@(errorMessage ?? "Course details could not be loaded.")">
        <NavLink class="btn btn-outline-danger" href="courses">Back to Courses</NavLink>
    </FeedbackPanel>
}
else if (course is not null)
{
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
        <div>
            <h1>@course.Code - @course.Name</h1>
            @if (course.IsActive)
            {
                <span class="badge bg-success">Active</span>
            }
            else
            {
                <span class="badge bg-secondary">Inactive</span>
            }
        </div>
        <NavLink class="btn btn-outline-secondary" href="courses">Back to Courses</NavLink>
    </div>

    @if (statusMessage is not null)
    {
        <FeedbackPanel Kind="FeedbackKind.Success"
                       Message="@statusMessage" />
    }

    @if (errorMessage is not null)
    {
        <FeedbackPanel Kind="FeedbackKind.Error"
                       Title="The action could not be completed"
                       Message="@errorMessage" />
    }

    @if (operationMessage is not null)
    {
        <LoadingIndicator Message="@operationMessage" />
    }

    <dl class="row">
        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@course.Description</dd>

        <dt class="col-sm-3">Level</dt>
        <dd class="col-sm-9">@course.Level</dd>

        <dt class="col-sm-3">Credit points</dt>
        <dd class="col-sm-9">@course.CreditPoints</dd>

        <dt class="col-sm-3">Syllabus</dt>
        <dd class="col-sm-9">@(course.SyllabusFileName ?? "No syllabus uploaded")</dd>
    </dl>

    <section class="mt-4" aria-labelledby="prerequisites-heading">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
            <div>
                <h2 id="prerequisites-heading" class="h4 mb-1">Prerequisites</h2>
                <p class="text-muted mb-0">Courses and minimum grades required before enrolment.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <NavLink class="btn btn-outline-primary"
                         href="@($"courses/{course.Id}/eligibility")">
                    Check eligibility
                </NavLink>
                <NavLink class="btn btn-primary"
                         href="@($"courses/{course.Id}/prerequisites/new")">
                    Add prerequisite
                </NavLink>
            </div>
        </div>

        @if (course.Prerequisites.Count == 0)
        {
            <FeedbackPanel Kind="FeedbackKind.Empty"
                           Title="No prerequisites"
                           Message="This Course has no prerequisite requirements." />
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th scope="col">Required Course</th>
                            <th scope="col">Minimum grade</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prerequisite in course.Prerequisites)
                        {
                            <tr>
                                <td>@prerequisite.RequiredCourseCode</td>
                                <td>@(prerequisite.MinimumGrade ?? "Pass")</td>
                                <td class="text-nowrap">
                                    <NavLink class="btn btn-sm btn-outline-secondary me-2"
                                             href="@($"courses/{course.Id}/prerequisites/{prerequisite.Id}/edit")">
                                        Edit
                                    </NavLink>
                                    <button class="btn btn-sm btn-outline-danger"
                                            disabled="@isSaving"
                                            @onclick="() => DeletePrerequisiteAsync(prerequisite)">
                                        Remove
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="mt-4" aria-labelledby="faculty-assignments-heading">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
            <div>
                <h2 id="faculty-assignments-heading" class="h4 mb-1">Faculty assignments</h2>
                <p class="text-muted mb-0">
                    Staff assigned to teach this Course during each teaching period.
                </p>
            </div>
            <NavLink class="btn btn-primary"
                     href="@($"courses/{course.Id}/faculty-assignments/new")">
                Add assignment
            </NavLink>
        </div>

        @if (course.FacultyAssignments.Count == 0)
        {
            <FeedbackPanel Kind="FeedbackKind.Empty"
                           Title="No faculty assignments"
                           Message="No staff members are assigned to this Course." />
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th scope="col">Staff member</th>
                            <th scope="col">Email</th>
                            <th scope="col">Role</th>
                            <th scope="col">Teaching period</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var assignment in course.FacultyAssignments)
                        {
                            <tr>
                                <td>@assignment.StaffName</td>
                                <td>
                                    <a href="@($"mailto:{assignment.StaffEmail}")">
                                        @assignment.StaffEmail
                                    </a>
                                </td>
                                <td>@assignment.Role</td>
                                <td>@assignment.TeachingPeriod</td>
                                <td class="text-nowrap">
                                    <NavLink class="btn btn-sm btn-outline-secondary me-2"
                                             href="@($"courses/{course.Id}/faculty-assignments/{assignment.Id}/edit")">
                                        Edit
                                    </NavLink>
                                    <button class="btn btn-sm btn-outline-danger"
                                            disabled="@isSaving"
                                            @onclick="() => DeleteFacultyAssignmentAsync(assignment)">
                                        Remove
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <div class="d-flex flex-wrap gap-2">
        <NavLink class="btn btn-primary" href="@($"courses/{course.Id}/edit")">Edit Course</NavLink>
        <button class="btn btn-outline-warning" disabled="@isSaving" @onclick="ToggleStatusAsync">
            @(course.IsActive ? "Deactivate" : "Reactivate")
        </button>
        <button class="btn btn-outline-danger" disabled="@isSaving" @onclick="DeleteAsync">
            Delete Course
        </button>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery]
    public string? Message { get; set; }

    private CourseDetail? course;
    private string? errorMessage;
    private string? statusMessage;
    private string? operationMessage;
    private bool isLoading = true;
    private bool isSaving;
    private bool loadFailed;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        loadFailed = false;
        errorMessage = null;
        operationMessage = null;
        statusMessage = Message switch
        {
            "created" => "Course created successfully.",
            "updated" => "Course updated successfully.",
            "prerequisite-created" => "Prerequisite added successfully.",
            "prerequisite-updated" => "Prerequisite updated successfully.",
            "faculty-assignment-created" => "Faculty assignment added successfully.",
            "faculty-assignment-updated" => "Faculty assignment updated successfully.",
            _ => null
        };

        try
        {
            course = await CourseApi.GetByIdAsync(Id);
        }
        catch (CourseApiException exception)
        {
            errorMessage = exception.Message;
            loadFailed = true;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Course details could not be loaded. Check that the Course Management API is running.";
            loadFailed = true;
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage = "Course details were returned in an unexpected format.";
            loadFailed = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ToggleStatusAsync()
    {
        if (course is null)
        {
            return;
        }

        isSaving = true;
        errorMessage = null;
        statusMessage = null;
        operationMessage = course.IsActive
            ? "Deactivating Course..."
            : "Reactivating Course...";

        try
        {
            var updatedCourse = await CourseApi.SetStatusAsync(course.Id, !course.IsActive);
            course = course with { IsActive = updatedCourse.IsActive };
            statusMessage = course.IsActive
                ? "Course reactivated successfully."
                : "Course deactivated successfully.";
        }
        catch (CourseApiException exception)
        {
            errorMessage = exception.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "The Course status could not be updated. Check that the API is running.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage = "The Course API returned an unexpected status response.";
        }
        finally
        {
            isSaving = false;
            operationMessage = null;
        }
    }

    private async Task DeletePrerequisiteAsync(PrerequisiteSummary prerequisite)
    {
        if (course is null)
        {
            return;
        }

        var confirmed = await JavaScript.InvokeAsync<bool>(
            "confirm",
            $"Remove {prerequisite.RequiredCourseCode} as a prerequisite for {course.Code}?");
        if (!confirmed)
        {
            return;
        }

        isSaving = true;
        errorMessage = null;
        statusMessage = null;
        operationMessage = $"Removing {prerequisite.RequiredCourseCode} prerequisite...";

        try
        {
            await CourseApi.DeletePrerequisiteAsync(prerequisite.Id);
            course = await CourseApi.GetByIdAsync(course.Id);
            statusMessage = "Prerequisite removed successfully.";
        }
        catch (CourseApiException exception)
        {
            errorMessage = exception.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "The prerequisite could not be removed. Check that the API is running.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage = "Course details could not be refreshed after removing the prerequisite.";
        }
        finally
        {
            isSaving = false;
            operationMessage = null;
        }
    }

    private async Task DeleteFacultyAssignmentAsync(FacultyAssignmentSummary assignment)
    {
        if (course is null)
        {
            return;
        }

        var confirmed = await JavaScript.InvokeAsync<bool>(
            "confirm",
            $"Remove {assignment.StaffName} from {course.Code} for {assignment.TeachingPeriod}?");
        if (!confirmed)
        {
            return;
        }

        isSaving = true;
        errorMessage = null;
        statusMessage = null;
        operationMessage = $"Removing {assignment.StaffName} faculty assignment...";

        try
        {
            await CourseApi.DeleteFacultyAssignmentAsync(assignment.Id);
            course = await CourseApi.GetByIdAsync(course.Id);
            statusMessage = "Faculty assignment removed successfully.";
        }
        catch (CourseApiException exception)
        {
            errorMessage = exception.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "The faculty assignment could not be removed. Check that the API is running.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage = "Course details could not be refreshed after removing the faculty assignment.";
        }
        finally
        {
            isSaving = false;
            operationMessage = null;
        }
    }

    private async Task DeleteAsync()
    {
        if (course is null)
        {
            return;
        }

        var confirmed = await JavaScript.InvokeAsync<bool>(
            "confirm",
            $"Delete {course.Code} - {course.Name}? This cannot be undone.");
        if (!confirmed)
        {
            return;
        }

        isSaving = true;
        errorMessage = null;
        statusMessage = null;
        operationMessage = $"Deleting {course.Code}...";

        try
        {
            await CourseApi.DeleteAsync(course.Id);
            Navigation.NavigateTo("/courses?message=deleted");
        }
        catch (CourseApiException exception)
        {
            errorMessage = exception.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "The Course could not be deleted. Check that the API is running.";
        }
        finally
        {
            isSaving = false;
            operationMessage = null;
        }
    }
}
