server {
    listen 80;
    listen [::]:80;
    server_name _;
    root /usr/share/nginx/html;

    resolver 127.0.0.11 valid=10s;

    location /api/ {
        set $backend_upstream ${BACKEND_BASE_URL};
        proxy_pass $backend_upstream$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /academic-api/ {
        set $academic_records_api ${ACADEMICRECORDS_API_BASE_URL};
        rewrite ^/academic-api/(.*)$ /$1 break;
        proxy_pass $academic_records_api$uri$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /_framework/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
