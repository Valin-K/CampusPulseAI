# CampusPulseAI shared agentic loop environment template
#
# 1. Copy this file to `.env` in the repository root:
#    Copy-Item .env.template .env
#
# 2. Replace the placeholder API key in `.env` with your actual key:
#    (Get-Content .env) `
#        -replace 'OPENROUTER_API_KEY=sk-or-v1-your-key-here', `
#                 'OPENROUTER_API_KEY=sk-or-v1-your-actual-key' `
#        | Set-Content .env
#
# 3. Run the agentic loop from the repository root after installing requirements:
#    python scripts\agentic-loop\agentic_loop.py

# Application AI: only the shared AI gateway container receives this key.
GEMINI_API_KEY=

# Required for the separate developer agentic-loop tool: OpenRouter API key
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: OpenRouter-compatible base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: default model used for all agentic-loop stages.
# The default is the OpenRouter Qwen 3.8 27B model. Override if you prefer a
# different model ID supported by OpenRouter.
AGENTIC_MODEL=qwen/qwen3.8-27b

# Per-stage model overrides.
# Use OpenRouter Qwen 3.8 27B for planning and implementation.
# Use Gemini 3.5 Flash for the independent review stage.
AGENTIC_PLAN_MODEL=qwen/qwen3.8-27b
AGENTIC_ACT_MODEL=qwen/qwen3.8-27b
AGENTIC_REVIEW_MODEL=gemini-3.5-flash

# AI provider: openrouter or gemini.
# Setting a stage model to a Gemini model name routes only that stage to Gemini;
# other stages remain on OpenRouter.
AGENTIC_PROVIDER=openrouter

# Gemini model used when a stage is routed to Gemini or when OpenRouter fails.
GEMINI_MODEL=gemini-3.5-flash

MCP_ENABLED=true
