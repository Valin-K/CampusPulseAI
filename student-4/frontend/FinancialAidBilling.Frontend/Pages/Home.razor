@page "/"
@using System.Net.Http.Json
@using FinancialAidBilling.Frontend.Models
@inject HttpClient Http
@inject IJSRuntime JS
@inject FinancialAidUserContext UserContext

<PageTitle>Financial Aid & Billing</PageTitle>

<header class="dashboard-hero">
    <div>
        <span class="eyebrow">Your financial workspace</span>
        <h1>Plan today. Stay ahead.</h1>
        <p>Track university charges, review payment activity, and discover funding opportunities in one focused dashboard.</p>
    </div>
    <div class="term-summary">
        <span>Signed-in student</span>
        <strong>@UserContext.CurrentUser!.FullName · @UserContext.CurrentUser.StudyDescriptor · Year @UserContext.CurrentUser.YearLevel</strong>
        <small>@UserContext.CurrentUser.Degree · @UserContext.CurrentUser.StudentId</small>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="notice notice-error" role="alert">@errorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="notice notice-success" role="status">@successMessage</div>
}

<section class="metric-grid" aria-label="Account summary">
    <CampusMetricCard Label="Outstanding balance" Value="@OutstandingBalance.ToString("C")" Detail="@($"{OutstandingCount} open invoices")" />
    <CampusMetricCard Label="Payments recorded" Value="@payments.Count.ToString()" Detail="@($"{payments.Sum(payment => payment.Amount):C} total")" Tone="green" />
    <CampusMetricCard Label="Active scholarships" Value="@scholarships.Count(item => item.IsActive).ToString()" Detail="Updated from the aid database" Tone="gold" />
</section>

<CampusSectionTabs Items="sections" @bind-ActiveKey="activeTab" AriaLabel="Financial aid sections" />

@if (activeTab == "billing")
{
    <div class="content-grid">
        <section class="surface-card">
            <div class="section-heading"><div><span class="eyebrow">Account activity</span><h2>@UserContext.CurrentUser!.FullName's invoices</h2></div><button class="button button-secondary" @onclick="LoadAllAsync">Refresh</button></div>
            @if (isLoading)
            {
                <div class="skeleton-stack"><span></span><span></span><span></span></div>
            }
            else
            {
                <div class="responsive-table">
                    <table>
                        <thead><tr><th>Description</th><th>Due</th><th>Amount</th><th>Status</th><th>Actions</th></tr></thead>
                        <tbody>
                            @foreach (var invoice in invoices.Where(item => item.StudentId == StudentId))
                            {
                                <tr>
                                    <td><strong>@invoice.Description</strong><small>Invoice #@invoice.Id</small></td>
                                    <td>@invoice.DueDate.ToString("MMM d, yyyy")</td>
                                    <td>@invoice.Amount.ToString("C")</td>
                                    <td><span class="status-badge @invoice.Status.ToString().ToLowerInvariant()">@invoice.Status</span></td>
                                    <td><div class="button-row">
                                        @if (invoice.Status != InvoiceStatus.Paid)
                                        {
                                            <button class="button button-small button-primary" @onclick="() => OpenPayment(invoice)">Pay</button>
                                        }
                                    </div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

    </div>
}
else if (activeTab == "scholarships")
{
    <section class="ai-card">
        <div><span class="eyebrow">MCP + Gemini guidance</span><h2>Find scholarships for @UserContext.CurrentUser!.FirstName</h2><p>Calls MCP for your academic statistics and matches open, unexpired scholarships by major and year. GPA eligibility requires aid-office review because the GPA scales differ.</p></div>
        <button class="button button-accent" @onclick="GetRecommendationsAsync" disabled="@isRecommending">@(isRecommending ? "Matching…" : "Find my matches")</button>
        @if (!string.IsNullOrWhiteSpace(aiRecommendation))
        {
            <div id="ai-recommendation" class="ai-response" tabindex="-1">
                <strong>@recommendationMatchCount potential database matches</strong>
                @if (recommendationAcademicContext is not null)
                {
                    <p>MCP academic GPA: @(recommendationAcademicContext.Gpa?.ToString("F2") ?? "Unavailable") / @recommendationAcademicContext.GpaScale</p>
                    <p>@recommendationAcademicContext.GpaEligibility</p>
                    <small>Tool: @recommendationAcademicContext.Tool · Student: @recommendationAcademicContext.StudentId · @recommendationAcademicContext.ExecutedAtUtc.ToLocalTime().ToString("g")</small>
                }
                <p>@aiRecommendation</p>
            </div>
        }
    </section>

    <section class="ai-card">
        <div>
            <span class="eyebrow">Shared AI services</span>
            <h2>Scholarship knowledge assistant</h2>
            <p>Retrieves scholarship catalogue passages through the shared RAG server and uses them to generate a source-grounded answer. Scholarship matching above uses MCP academic statistics; the registration check below is diagnostic only.</p>
        </div>
        <div class="form-stack">
            <label class="field">
                <span>Ask about scholarships</span>
                <input @bind="ragQuestion" maxlength="1000" placeholder="Which scholarships are open to computing students?" />
            </label>
            <div class="button-row">
                <button class="button button-accent" @onclick="AskScholarshipAssistantAsync" disabled="@(isAskingRag || string.IsNullOrWhiteSpace(ragQuestion))">@(isAskingRag ? "Searching…" : "Ask the knowledge assistant")</button>
                <button class="button button-secondary" @onclick="CheckMcpIntegrationAsync" disabled="@isCheckingMcp">@(isCheckingMcp ? "Checking…" : "Check MCP registration")</button>
            </div>
        </div>
        @if (mcpIntegration is { IsError: false, Result.Checks: not null })
        {
            <div class="ai-response" role="status">
                <strong>@(mcpIntegration.Result.Valid ? "MCP integration check succeeded" : "MCP integration check failed")</strong>
                <p>Shared MCP registry validation for @mcpIntegration.Result.Feature.</p>
                <ul class="detail-list">
                    @foreach (var check in mcpIntegration.Result.Checks)
                    {
                        <li><strong>@check.Name</strong>: @(check.Passed ? "Passed" : "Failed")</li>
                    }
                </ul>
            </div>
        }
        @if (ragAnswer is not null)
        {
            <div class="ai-response" role="status">
                <strong>@RagStatusLabel · @ragAnswer.Status</strong>
                <div class="rag-answer">
                    <SafeMarkdown Content="@(ragAnswer.Answer ?? ragAnswer.Detail ?? "Relevant catalogue passages were retrieved.")" />
                </div>
                @if (ragAnswer.Sources.Count > 0)
                {
                    <ul class="detail-list">
                        @foreach (var source in ragAnswer.Sources)
                        {
                            <li><strong>[@source.Rank] @(source.Metadata?.GetValueOrDefault("title") ?? source.Metadata?.GetValueOrDefault("scholarshipName") ?? source.DocumentId)</strong><p>@source.Text</p></li>
                        }
                    </ul>
                }
            </div>
        }
    </section>

    <div class="content-grid">
        <section class="surface-card">
            <div class="section-heading"><div><span class="eyebrow">Available funding</span><h2>Scholarships</h2></div></div>
            <div class="card-grid">
                @foreach (var scholarship in scholarships)
                {
                    <article class="scholarship-card">
                        <div class="card-topline"><span class="status-badge @(scholarship.IsActive ? "paid" : "overdue")">@(scholarship.IsActive ? "Active" : "Closed")</span><strong>@scholarship.AwardAmount.ToString("C0")</strong></div>
                        <h3>@scholarship.Name</h3><p>@scholarship.Description</p>
                        <ul class="detail-list"><li>GPA @scholarship.MinimumGpa.ToString("F2")+</li><li>@scholarship.EligibleMajor</li><li>Due @scholarship.ApplicationDeadline.ToString("MMM d, yyyy")</li></ul>
                    </article>
                }
            </div>
        </section>

    </div>
}
else
{
    <section class="surface-card">
        <div class="section-heading"><div><span class="eyebrow">Receipts</span><h2>Payment history</h2></div></div>
        <div class="responsive-table"><table><thead><tr><th>Reference</th><th>Invoice</th><th>Date</th><th>Method</th><th>Amount</th></tr></thead><tbody>
            @foreach (var payment in payments.Where(item => item.StudentId == StudentId))
            {
                <tr><td><strong>@payment.Reference</strong></td><td>#@payment.InvoiceId</td><td>@payment.PaidAtUtc.ToLocalTime().ToString("MMM d, yyyy")</td><td>@payment.Method</td><td>@payment.Amount.ToString("C")</td></tr>
            }
        </tbody></table></div>
    </section>
}

@if (paymentInvoice is not null)
{
    <div class="modal-backdrop" @onclick="ClosePayment"><section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="payment-title" @onclick:stopPropagation="true">
        <button class="modal-close" aria-label="Close" @onclick="ClosePayment">×</button><span class="eyebrow">Dummy transaction</span><h2 id="payment-title">Pay invoice #@paymentInvoice.Id</h2><p>@paymentInvoice.Description · @paymentInvoice.Amount.ToString("C")</p>
        <form class="form-stack" @onsubmit="SubmitPaymentAsync" @onsubmit:preventDefault="true">
            <label class="field"><span>Payment amount</span><input type="number" min="0.01" max="@paymentInvoice.Amount" step="0.01" @bind="paymentDraft.Amount" /></label>
            <label class="field"><span>Method</span><select @bind="paymentDraft.Method">@foreach (var method in Enum.GetValues<PaymentMethod>()) { <option value="@method">@method</option> }</select></label>
            <label class="field"><span>Reference</span><input @bind="paymentDraft.Reference" maxlength="64" /></label>
            <button class="button button-primary" type="submit">Submit dummy payment</button>
        </form>
    </section></div>
}

@code {
    private int StudentId => UserContext.CurrentUser!.UserId;
    private static readonly IReadOnlyList<CampusTabItem> sections =
    [
        new("billing", "Billing", "Invoices and account charges"),
        new("scholarships", "Scholarships", "Funding matches and awards"),
        new("payments", "Payment history", "Receipts and transactions")
    ];

    private readonly List<InvoiceResponse> invoices = [];
    private readonly List<PaymentResponse> payments = [];
    private readonly List<ScholarshipResponse> scholarships = [];
    private PaymentInput paymentDraft = new();
    private InvoiceResponse? paymentInvoice;
    private string activeTab = "billing";
    private string? errorMessage;
    private string? successMessage;
    private string? aiRecommendation;
    private int recommendationMatchCount;
    private ScholarshipAcademicContext? recommendationAcademicContext;
    private string ragQuestion = string.Empty;
    private McpIntegrationResponse? mcpIntegration;
    private RagAnswerResponse? ragAnswer;
    private bool isLoading;
    private bool isRecommending;
    private bool isCheckingMcp;
    private bool isAskingRag;

    private string RagStatusLabel => ragAnswer?.Status switch
    {
        "answered" => "Source-grounded RAG answer",
        "insufficient_context" => "Not enough scholarship evidence",
        "generation_unavailable" => "Passages retrieved; answer generation unavailable",
        "generation_failed" => "Passages retrieved; answer generation failed",
        _ => "Unexpected RAG response"
    };

    private decimal OutstandingBalance => invoices.Where(item => item.StudentId == StudentId && item.Status != InvoiceStatus.Paid).Sum(item => item.Amount);
    private int OutstandingCount => invoices.Count(item => item.StudentId == StudentId && item.Status != InvoiceStatus.Paid);

    protected override Task OnInitializedAsync() => LoadAllAsync();

    private async Task LoadAllAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var invoiceTask = Http.GetFromJsonAsync<List<InvoiceResponse>>("/api/invoices");
            var paymentTask = Http.GetFromJsonAsync<List<PaymentResponse>>("/api/payments");
            var scholarshipTask = Http.GetFromJsonAsync<List<ScholarshipResponse>>("/api/scholarships");
            await Task.WhenAll(invoiceTask, paymentTask, scholarshipTask);
            invoices.Clear(); invoices.AddRange(await invoiceTask ?? []);
            payments.Clear(); payments.AddRange(await paymentTask ?? []);
            scholarships.Clear(); scholarships.AddRange(await scholarshipTask ?? []);
        }
        catch (HttpRequestException) { errorMessage = "The Financial Aid & Billing service is unavailable."; }
        finally { isLoading = false; }
    }

    private void OpenPayment(InvoiceResponse invoice)
    {
        paymentInvoice = invoice;
        var paid = payments.Where(item => item.InvoiceId == invoice.Id).Sum(item => item.Amount);
        paymentDraft = new() { InvoiceId = invoice.Id, StudentId = StudentId, Amount = invoice.Amount - paid };
    }

    private void ClosePayment() => paymentInvoice = null;

    private async Task SubmitPaymentAsync()
    {
        await SaveAsync(Http.PostAsJsonAsync("/api/payments", paymentDraft.ToRequest()), "Dummy payment recorded.");
        if (errorMessage is null) ClosePayment();
    }

    private async Task GetRecommendationsAsync()
    {
        isRecommending = true; errorMessage = null; aiRecommendation = null; recommendationAcademicContext = null;
        try
        {
            using var response = await Http.PostAsync($"/api/scholarships/recommendations/student/{StudentId}", null);
            if (!response.IsSuccessStatusCode) { errorMessage = await ReadRecommendationErrorAsync(response); return; }
            var result = await response.Content.ReadFromJsonAsync<ScholarshipRecommendationResponse>();
            if (result?.AcademicContext is null) { errorMessage = "The recommendation service returned an invalid response."; return; }
            aiRecommendation = result.Recommendation;
            recommendationMatchCount = result.MatchCount;
            recommendationAcademicContext = result.AcademicContext;
            await JS.InvokeVoidAsync("UniversityUI.reveal", "ai-recommendation");
        }
        catch (HttpRequestException) { errorMessage = "Scholarship recommendations are unavailable. Check MCP, Academic Records, and the AI gateway."; }
        catch (System.Text.Json.JsonException) { errorMessage = "The recommendation service returned an invalid response."; }
        catch (TaskCanceledException) { errorMessage = "The scholarship recommendation request timed out."; }
        finally { isRecommending = false; }
    }

    private static async Task<string> ReadRecommendationErrorAsync(HttpResponseMessage response)
    {
        var responseBody = await response.Content.ReadAsStringAsync();
        if (!string.IsNullOrWhiteSpace(responseBody))
        {
            try
            {
                using var document = System.Text.Json.JsonDocument.Parse(responseBody);
                var root = document.RootElement;
                if (root.TryGetProperty("detail", out var detail)
                    && detail.ValueKind == System.Text.Json.JsonValueKind.String
                    && !string.IsNullOrWhiteSpace(detail.GetString()))
                {
                    return detail.GetString()!;
                }

                if (root.TryGetProperty("title", out var title)
                    && title.ValueKind == System.Text.Json.JsonValueKind.String
                    && !string.IsNullOrWhiteSpace(title.GetString()))
                {
                    return title.GetString()!;
                }
            }
            catch (System.Text.Json.JsonException)
            {
                // Use the HTTP status below when the response is not ProblemDetails JSON.
            }
        }

        return $"Scholarship recommendations are unavailable (HTTP {(int)response.StatusCode}).";
    }

    private async Task CheckMcpIntegrationAsync()
    {
        isCheckingMcp = true; errorMessage = null; mcpIntegration = null;
        try
        {
            using var response = await Http.PostAsync("/api/assistant/mcp/integration", null);
            if (!response.IsSuccessStatusCode) { errorMessage = await response.Content.ReadAsStringAsync(); return; }
            mcpIntegration = await response.Content.ReadFromJsonAsync<McpIntegrationResponse>();
            if (mcpIntegration?.Result is null || mcpIntegration.Result.Checks is null)
            {
                errorMessage = "The MCP integration service returned an invalid response.";
            }
            else if (mcpIntegration.IsError || !mcpIntegration.Result.Valid)
            {
                errorMessage = "The MCP integration check did not succeed.";
            }
        }
        catch (System.Text.Json.JsonException) { errorMessage = "The MCP integration service returned an invalid response."; }
        catch (HttpRequestException) { errorMessage = "The shared MCP server is currently unavailable."; }
        finally { isCheckingMcp = false; }
    }

    private async Task AskScholarshipAssistantAsync()
    {
        isAskingRag = true; errorMessage = null; ragAnswer = null;
        try
        {
            using var response = await Http.PostAsJsonAsync("/api/assistant/rag/scholarships", new RagQuestionRequest(ragQuestion));
            if (!response.IsSuccessStatusCode) { errorMessage = await response.Content.ReadAsStringAsync(); return; }
            ragAnswer = await response.Content.ReadFromJsonAsync<RagAnswerResponse>();
            if (ragAnswer is null) { errorMessage = "The RAG server returned an invalid response."; }
        }
        catch (HttpRequestException) { errorMessage = "The shared RAG server is currently unavailable."; }
        catch (System.Text.Json.JsonException) { errorMessage = "The RAG server returned an invalid response."; }
        catch (TaskCanceledException) { errorMessage = "The scholarship knowledge request timed out."; }
        finally { isAskingRag = false; }
    }

    private async Task SaveAsync(Task<HttpResponseMessage> request, string message)
    {
        errorMessage = null; successMessage = null;
        try
        {
            using var response = await request;
            if (!response.IsSuccessStatusCode) { errorMessage = await response.Content.ReadAsStringAsync(); return; }
            successMessage = message;
            await LoadAllAsync();
            await JS.InvokeVoidAsync("UniversityUI.toast", message);
        }
        catch (HttpRequestException) { errorMessage = "The Financial Aid & Billing service is unavailable."; }
    }

    private async Task DeleteAsync(string url, string message)
    {
        errorMessage = null; successMessage = null;
        try
        {
            using var response = await Http.DeleteAsync(url);
            if (!response.IsSuccessStatusCode) { errorMessage = await response.Content.ReadAsStringAsync(); return; }
            successMessage = message;
            await LoadAllAsync();
            await JS.InvokeVoidAsync("UniversityUI.toast", message);
        }
        catch (HttpRequestException) { errorMessage = "The requested record could not be deleted."; }
    }
}
