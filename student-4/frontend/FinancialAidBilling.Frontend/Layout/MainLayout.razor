@inherits LayoutComponentBase
@inject FinancialAidUserContext UserContext
@inject AccountService Account

<CampusShell PageName="Financial Aid &amp; Billing"
             SectionLabel="Student finance"
             UserName="@(Account.CurrentUser?.FullName ?? "Financial Aid & Billing")"
             UserDetails="@(Account.CurrentUser is null ? "Finance workspace" : $"{Account.CurrentUser.Role} · {Account.CurrentUser.ExternalId}")"
             UserInitials="@(Account.CurrentUser?.Initials ?? "FA")"
             HomeHref="http://localhost:8080"
             RequireSignedInUser="true">
    <ChildContent>
        @if (!UserContext.IsInitialized)
        {
            <div class="notice" role="status">Loading student information...</div>
        }
        else if (IsStaffAccount)
        {
            <section class="notice notice-error" role="alert">
                <h1>Student access required</h1>
                <p>Financial Aid &amp; Billing is available to students only. Staff accounts cannot access this workspace.</p>
                <p>You will be redirected to student sign-in shortly.</p>
                <button class="button button-primary" @onclick="RedirectToStudentLoginAsync">
                    Continue to student sign-in
                </button>
            </section>
        }
        else if (!UserContext.IsAvailable)
        {
            <div class="notice notice-error" role="alert">
                <p>@(UserContext.ErrorMessage ?? "Student information could not be loaded.")</p>
                <button class="button button-secondary" @onclick="RetryAsync">Try again</button>
            </div>
        }
        else
        {
            @Body
        }
    </ChildContent>
</CampusShell>

@if (Account.CurrentUser is not null)
{
    <CampusAiChat />
}

@code {
    [Inject]
    private AuthenticationStateProvider Authentication { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private bool redirectingToStudentLogin;
    private bool staffRedirectStarted;
    private bool IsStaffAccount => Account.CurrentUser is { } user
        && AccountService.IsStaff(user);

    protected override async Task OnInitializedAsync()
    {
        await Account.InitializeAsync();
        await UserContext.InitializeAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (UserContext.IsInitialized && IsStaffAccount && !staffRedirectStarted)
        {
            staffRedirectStarted = true;
            _ = RedirectAfterDelayAsync();
        }

        return Task.CompletedTask;
    }

    private async Task RedirectAfterDelayAsync()
    {
        await Task.Delay(TimeSpan.FromSeconds(3));
        await RedirectToStudentLoginAsync();
    }

    private async Task RedirectToStudentLoginAsync()
    {
        if (redirectingToStudentLogin)
        {
            return;
        }

        redirectingToStudentLogin = true;
        if (IsStaffAccount)
        {
            await Authentication.SignOutAsync();
        }

        var returnUrl = Uri.EscapeDataString(Navigation.BaseUri);
        Navigation.NavigateTo(
            $"http://localhost:8081/login/student?returnUrl={returnUrl}",
            forceLoad: true);
    }

    private async Task RetryAsync()
    {
        await UserContext.InitializeAsync(forceRefresh: true);
    }
}
