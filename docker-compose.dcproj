<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" Sdk="Microsoft.Docker.Sdk">
  <PropertyGroup Label="Globals">
    <ProjectVersion>2.1</ProjectVersion>
    <DockerTargetOS>Linux</DockerTargetOS>
    <ProjectGuid>81dded9d-158b-e303-5f62-77a2896d2a5a</ProjectGuid>
    <DockerLaunchAction>LaunchBrowser</DockerLaunchAction>
    <DockerServiceUrl>http://localhost:8081</DockerServiceUrl>
    <DockerServiceName>academicrecords.frontend</DockerServiceName>
    <DockerComposeProjectsToIgnore>student-2\frontend\CourseManagement.Frontend\CourseManagement.Frontend.csproj</DockerComposeProjectsToIgnore>
  </PropertyGroup>
  <ItemGroup>
    <None Include=".github\docker-compose.student-4.ci.yml" />
    <None Include="docker-compose.override.yml">
      <DependentUpon>docker-compose.yml</DependentUpon>
    </None>
    <None Include="docker-compose.yml" />
    <None Include=".dockerignore" />
    <None Include="shared\frontend\CampusPulse.Shared.Components\CampusMetricCard.razor" />
    <None Include="shared\frontend\CampusPulse.Shared.Components\CampusMetricCard.razor.css" />
    <None Include="shared\frontend\CampusPulse.Shared.Components\CampusNavBar.razor" />
    <None Include="shared\frontend\CampusPulse.Shared.Components\CampusNavBar.razor.css" />
    <None Include="shared\frontend\CampusPulse.Shared.Components\CampusPulse.Shared.Components.csproj" />
    <None Include="shared\frontend\CampusPulse.Shared.Components\CampusSectionTabs.razor" />
    <None Include="shared\frontend\CampusPulse.Shared.Components\CampusSectionTabs.razor.css" />
    <None Include="shared\frontend\CampusPulse.Shared.Components\CampusShell.razor" />
    <None Include="shared\frontend\CampusPulse.Shared.Components\CampusShell.razor.css" />
    <None Include="shared\frontend\CampusPulse.Shared.Components\Models\CampusTabItem.cs" />
    <None Include="shared\frontend\CampusPulse.Shared.Components\_Imports.razor" />
    <None Include="shared\frontend\css\university-theme.css" />
    <None Include="shared\frontend\js\campus-nav-bar.js" />
    <None Include="shared\frontend\js\university-ui.js" />
    <None Include="student-1\database\AcademicRecords.Database\AcademicRecords.Database.csproj" />
    <None Include="student-1\database\AcademicRecords.Database\Dockerfile" />
    <None Include="student-2\database\CourseManagement.Database\CourseManagement.Database.csproj" />
    <None Include="student-2\database\CourseManagement.Database\Dockerfile" />
    <None Include="student-3\database\CampusHousing.Database\CampusHousing.Database.csproj" />
    <None Include="student-3\database\CampusHousing.Database\Dockerfile" />
    <None Include="student-4\database\FinancialAidBilling.Database\Dockerfile" />
    <None Include="student-4\database\FinancialAidBilling.Database\FinancialAidBilling.Database.csproj" />
