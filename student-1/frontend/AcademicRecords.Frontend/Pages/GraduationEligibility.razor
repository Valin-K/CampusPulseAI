@page "/profile/{Role}/{UserId:int}/graduation"
@using System.Net.Http.Json

<PageTitle>Graduation Eligibility</PageTitle>

<h1>Graduation Eligibility</h1>

@if (isLoading)
{
    <p>Loading graduation eligibility...</p>
}
else if (loadError is not null)
{
    <div class="alert alert-danger">Unable to load graduation eligibility: @loadError</div>
}
else if (eligibility is not null)
{
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="card-title h5">Current status</h2>
            <p class="fs-4 @(eligibility.IsEligible ? "text-success" : "text-warning")">
                @(eligibility.IsEligible ? "Eligible to graduate" : "Not yet eligible to graduate")
            </p>
            <p class="mb-0">
                Credit points earned: <strong>@eligibility.EarnedCreditPoints.ToString("0.##")</strong>
                of <strong>@eligibility.RequiredCreditPoints.ToString("0.##")</strong>
            </p>
        </div>
    </div>

    @if (eligibility.OutstandingRequirements.Count > 0)
    {
        <h2 class="h5">Outstanding requirements</h2>
        <ol>
            @foreach (var requirement in eligibility.OutstandingRequirements)
            {
                <li>@requirement</li>
            }
        </ol>
    }
    else
    {
        <div class="alert alert-success">All graduation eligibility requirements have been met.</div>
    }

    @if (graduationDate is not null)
    {
        <p class="text-muted">Graduation date: @graduationDate.Value.ToString("yyyy-MM-dd")</p>
    }

    <div class="card mt-4">
        <div class="card-body">
            <h2 class="card-title h5">AI progress analysis</h2>
            <p class="ai-progress-blurb">Analyze your credit pace, grades, and course-taking pattern to estimate your graduation timeline and identify academic risks.</p>
            @if (analysis is not null)
            {
                <div class="alert @(analysis.Succeeded ? "ai-analysis-success" : "ai-analysis-failure") mt-3">
                    <strong>Request status: @analysis.Status</strong>
                    <div>@analysis.Message</div>
                </div>
                <div class="row g-3">
                    <div class="col-md-6"><strong>Credits</strong><br />@analysis.Metrics.EarnedCredits.ToString("0.##") of @analysis.Metrics.RequiredCredits.ToString("0.##") (@analysis.Metrics.CreditsRemaining.ToString("0.##") remaining)</div>
                    <div class="col-md-6"><strong>Average credits per academic year</strong><br />@analysis.Metrics.AverageCreditsPerYear.ToString("0.##")</div>
                    @if (analysis.Prediction is not null)
                    {
                        <div class="col-12"><strong>Expected graduation</strong><br />@analysis.Prediction.ExpectedGraduationTerm (@analysis.Prediction.ExpectedGraduationDate)<br /><span class="ai-explanation">@analysis.Prediction.Explanation</span></div>
                    }
                </div>
                @if (analysis.RiskFlags.Count > 0)
                {
                    <h3 class="h6 fw-bold mt-3">Academic risk flags</h3>
                    <ul>
                        @foreach (var flag in analysis.RiskFlags)
                        {
                            <li>
                                <strong>@flag.Severity: @flag.Category</strong>
                                <p class="mb-1">@flag.Description</p>
                                <p class="ai-recommended-action"><strong>Recommended action:</strong> @flag.RecommendedAction</p>
                            </li>
                        }
                    </ul>
                }
            }

            <button class="btn btn-primary mt-3" @onclick="RunAnalysisAsync" disabled="@isAnalysing">
                @(isAnalysing ? "Analysing..." : "Analyse my progress")
            </button>
        </div>
    </div>
}

<div class="mt-4">
    <a href="/profile/@Role/@UserId/enrollments" class="btn btn-primary">View enrollments</a>
    <a href="/profile/@Role/@UserId" class="btn btn-secondary ms-2">Back to profile</a>
</div>

@code {
    [Parameter]
    public int UserId { get; set; }

    [Parameter]
    public string Role { get; set; } = string.Empty;

    [Inject]
    private HttpClient Http { get; set; } = default!;

    private bool isLoading = true;
    private string? loadError;
    private string? studentId;
    private GraduationEligibilityResponse? eligibility;
    private DateOnly? graduationDate;
    private AcademicProgressAnalysisResponse? analysis;
    private bool isAnalysing;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var student = await Http.GetFromJsonAsync<StudentProfileResponse>($"api/students/by-user/{UserId}");
            if (student is null)
            {
                loadError = "Student profile not found.";
                return;
            }

            studentId = student.StudentId;
            graduationDate = student.GraduationDate;
            eligibility = await Http.GetFromJsonAsync<GraduationEligibilityResponse>(
                $"api/students/{Uri.EscapeDataString(student.StudentId)}/eligibility");
        }
        catch (HttpRequestException exception)
        {
            loadError = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RunAnalysisAsync()
    {
        if (studentId is null)
        {
            return;
        }

        isAnalysing = true;
        try
        {
            using var response = await Http.PostAsync($"api/students/{Uri.EscapeDataString(studentId)}/ai-analysis", null);
            analysis = await response.Content.ReadFromJsonAsync<AcademicProgressAnalysisResponse>()
                ?? new(false, "Failed", "The AI service returned an empty response.", null, [], new(0, 0, 0, 0, null, null, 0, 0));
        }
        catch (HttpRequestException exception)
        {
            analysis = new(false, "Failed", exception.Message, null, [], new(0, 0, 0, 0, null, null, 0, 0));
        }
        finally
        {
            isAnalysing = false;
        }
    }

    private sealed record StudentProfileResponse(
        int UserId,
        string StudentId,
        DateOnly? GraduationDate = null);

    private sealed record GraduationEligibilityResponse(
        bool IsEligible,
        decimal EarnedCreditPoints,
        decimal RequiredCreditPoints,
        List<string> OutstandingRequirements);

    private sealed record AcademicProgressAnalysisResponse(
        bool Succeeded,
        string Status,
        string? Message,
        AcademicProgressPrediction? Prediction,
        List<AcademicRiskFlag> RiskFlags,
        AcademicProgressMetrics Metrics);

    private sealed record AcademicProgressPrediction(string ExpectedGraduationTerm, string ExpectedGraduationDate, string Explanation);

    private sealed record AcademicRiskFlag(string Severity, string Category, string Description, string RecommendedAction);

    private sealed record AcademicProgressMetrics(
        decimal EarnedCredits,
        decimal RequiredCredits,
        decimal CreditsRemaining,
        decimal AverageCreditsPerYear,
        decimal? OverallGpa,
        decimal? RecentGpa,
        int CompletedYears,
        int FailedCourses);
}
