@page "/"
@inject CampusAccountService Account
@inject NavigationManager Navigation

<PageTitle>Academic Records</PageTitle>

<p class="muted" role="status">Opening your Academic Records workspace...</p>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Account.InitializeAsync();

        var user = Account.CurrentUser;
        if (user is null || user.UserId <= 0)
        {
            return;
        }

        var destination = CampusAccountService.IsStudent(user)
            ? $"students/{user.UserId}"
            : CampusAccountService.IsStaff(user)
                ? $"staff/{user.UserId}"
                : null;

        if (destination is not null)
        {
            Navigation.NavigateTo(destination, replace: true);
        }
    }
}