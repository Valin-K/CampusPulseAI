@page "/"

<PageTitle>Academic Records</PageTitle>

<h1>People</h1>

@if (people is null && error is null)
{
    <p>Loading...</p>
}
else if (error is not null)
{
    <p class="text-danger">Unable to load people: @error</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Role</th>
                <th>Student ID</th>
                <th>Staff ID</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var person in people!)
            {
                <tr>
                    <td>@person.FirstName @person.LastName</td>
                    <td>@person.Role</td>
                    <td>@person.StudentId</td>
                    <td>@person.StaffId</td>
                    <td>@person.Email</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<PersonResponse>? people;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            people = await Http.GetFromJsonAsync<IReadOnlyList<PersonResponse>>("api/users");
        }
        catch (HttpRequestException exception)
        {
            error = exception.Message;
        }
    }

    [Inject]
    private HttpClient Http { get; set; } = default!;

    private sealed record PersonResponse(
        int UserId,
        string FirstName,
        string LastName,
        string Email,
        string Role,
        string? StudentId,
        string? StaffId);
}
