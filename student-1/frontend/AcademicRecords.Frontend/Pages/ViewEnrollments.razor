@page "/profile/{Role}/{UserId:int}/enrollments"
@using System.Globalization
@using System.Net.Http.Json

<PageTitle>Enrollments</PageTitle>

<h1>Course Enrollments</h1>

@if (isLoading)
{
    <p>Loading enrollments...</p>
}
else if (loadError is not null)
{
    <div class="alert alert-danger">Unable to load enrollments: @loadError</div>
}
else
{
    <h2>Current and Future Enrollments</h2>
    @if (currentEnrollments.Count == 0)
    {
        <p>No current enrollments.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Course Code</th>
                    <th>Term</th>
                    <th>Academic Year</th>
                    <th>Status</th>
                    <th>Credits</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var enrollment in currentEnrollments)
                {
                    <tr>
                        <td>@enrollment.CourseCode</td>
                        <td>@enrollment.TermName (@enrollment.TermCode)</td>
                        <td>@enrollment.AcademicYear</td>
                        <td>@enrollment.Status</td>
                        <td>@enrollment.Credits</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h2>Past Enrollments</h2>
    @if (pastEnrollments.Count == 0)
    {
        <p>No past enrollments.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Course Code</th>
                    <th>Term</th>
                    <th>Academic Year</th>
                    <th>Status</th>
                    <th>Credits</th>
                    <th>Grade Type</th>
                    <th>Grade</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var enrollment in pastEnrollments)
                {
                    <tr>
                        <td>@enrollment.CourseCode</td>
                        <td>@enrollment.TermName (@enrollment.TermCode)</td>
                        <td>@enrollment.AcademicYear</td>
                        <td>@enrollment.Status</td>
                        <td>@enrollment.Credits</td>
                        <td>@enrollment.GradeType</td>
                        <td>@GetGradeDisplay(enrollment)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<a href="/profile/@Role/@UserId" class="btn btn-secondary mt-4">Back to profile</a>

@code {
    [Parameter]
    public int UserId { get; set; }

    [Parameter]
    public string Role { get; set; } = string.Empty;

    [Inject]
    private HttpClient Http { get; set; } = default!;

    private bool isLoading = true;
    private string? loadError;
    private List<TermEnrollmentResponse> currentEnrollments = [];
    private List<TermEnrollmentResponse> pastEnrollments = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var student = await Http.GetFromJsonAsync<StudentProfileResponse>($"api/students/by-user/{UserId}");
            if (student is null)
            {
                loadError = "Profile not found.";
                return;
            }

            var today = DateOnly.FromDateTime(DateTime.UtcNow);
            currentEnrollments = [];
            pastEnrollments = [];

            foreach (var enrollment in student.Enrollments)
            {
                var startDate = GetTermStartDate(enrollment.AcademicYear, enrollment.StartWeekOfYear);
                var endDate = GetTermEndDate(enrollment.AcademicYear, enrollment.StartWeekOfYear, enrollment.EndWeekOfYear);
                if (startDate is not null && (endDate is null || today <= endDate))
                {
                    currentEnrollments.Add(enrollment);
                }
                else
                {
                    pastEnrollments.Add(enrollment);
                }
            }

            currentEnrollments = currentEnrollments
                .OrderBy(enrollment => GetTermStartDate(enrollment.AcademicYear, enrollment.StartWeekOfYear))
                .ThenBy(enrollment => enrollment.CourseCode)
                .ToList();
            pastEnrollments = pastEnrollments
                .OrderBy(enrollment => GetTermStartDate(enrollment.AcademicYear, enrollment.StartWeekOfYear))
                .ThenBy(enrollment => enrollment.CourseCode)
                .ToList();
        }
        catch (HttpRequestException exception)
        {
            loadError = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static DateOnly? GetTermStartDate(int academicYear, int startWeekOfYear)
    {
        if (startWeekOfYear <= 0 || startWeekOfYear > ISOWeek.GetWeeksInYear(academicYear))
        {
            return null;
        }

        return DateOnly.FromDateTime(ISOWeek.ToDateTime(academicYear, startWeekOfYear, DayOfWeek.Monday));
    }

    private static string GetGradeDisplay(TermEnrollmentResponse enrollment) =>
        enrollment.GradeType is "Pass/Fail" or "Ungraded"
            ? "N/A"
            : enrollment.IsFinalized ? enrollment.GradeValue?.ToString() ?? "N/A" : "Pending";

    private static DateOnly? GetTermEndDate(int academicYear, int startWeekOfYear, int endWeekOfYear)
    {
        if (endWeekOfYear <= 0 || endWeekOfYear > 53)
        {
            return null;
        }

        var endYear = endWeekOfYear < startWeekOfYear ? academicYear + 1 : academicYear;
        var weeksInYear = ISOWeek.GetWeeksInYear(endYear);
        var week = Math.Min(endWeekOfYear, weeksInYear);
        var endOfWeek = ISOWeek.ToDateTime(endYear, week, DayOfWeek.Sunday);
        return DateOnly.FromDateTime(endOfWeek);
    }

    private sealed record StudentProfileResponse(int UserId, string StudentId, string FirstName, string LastName, string Email,
        DateOnly? DateOfBirth, string? PhoneNumber, string MailingAddress, string EmergencyContactName,
        string EmergencyContactPhone, DateOnly? EnrollmentDate, string? Degree, string? Major, string? SubMajor,
        List<TermEnrollmentResponse> Enrollments);

    private sealed record TermEnrollmentResponse(int EnrollmentId, string CourseCode, int? AcademicTermId, string? TermCode,
        string? TermName, int StartWeekOfYear, int EndWeekOfYear, int AcademicYear, string Status, decimal? Credits, string GradeType, decimal? GradeValue, bool IsFinalized);
}
