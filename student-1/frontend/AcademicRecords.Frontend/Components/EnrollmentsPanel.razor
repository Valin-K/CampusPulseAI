@using System.Globalization
@using System.Net.Http.Json

@if (isLoading)
{
    <p class="muted">Loading enrollments...</p>
}
else if (loadError is not null)
{
    <div class="notice notice-error">Unable to load enrollments: @loadError</div>
}
else
{
    <div class="metric-grid">
        <CampusMetricCard Label="WAM" Value="@FormatStatistic(wam?.Value)" Detail="Weighted average mark" />
        <CampusMetricCard Label="GPA" Value="@FormatStatistic(gpa?.Value)" Detail="Grade point average" Tone="green" />
        <CampusMetricCard Label="Credit points gained" Value="@FormatCreditPoints()" Detail="Earned from passed and completed courses" Tone="gold" />
    </div>

    <section class="surface-card table-panel">
        <div class="section-heading">
            <div><span class="eyebrow">Current and future</span><h2>Current and future enrollments</h2></div>
        </div>
        @if (currentEnrollments.Count == 0)
        {
            <p class="muted">No current enrollments.</p>
        }
        else
        {
            <div class="responsive-table">
                <table>
                    <thead>
                        <tr>
                            <th>Course Code</th>
                            <th>Course Name</th>
                            <th>Term</th>
                            <th>Academic Year</th>
                            <th>Status</th>
                            <th>Credits</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var enrollment in currentEnrollments)
                        {
                            <tr>
                                <td>@enrollment.CourseCode</td>
                                <td>@(enrollment.CourseTitle ?? enrollment.CourseCode)</td>
                                <td>@enrollment.TermName (@enrollment.TermCode)</td>
                                <td>@enrollment.AcademicYear</td>
                                <td>@enrollment.Status</td>
                                <td>@enrollment.Credits</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="surface-card table-panel">
        <div class="section-heading">
            <div><span class="eyebrow">History</span><h2>Past enrollments</h2></div>
        </div>
        @if (pastEnrollments.Count == 0)
        {
            <p class="muted">No past enrollments.</p>
        }
        else
        {
            <div class="responsive-table">
                <table>
                    <thead>
                        <tr>
                            <th>Course Code</th>
                            <th>Course Name</th>
                            <th>Term</th>
                            <th>Academic Year</th>
                            <th>Status</th>
                            <th>Credits</th>
                            <th>Grade Type</th>
                            <th>Grade</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var enrollment in pastEnrollments)
                        {
                            <tr>
                                <td>@enrollment.CourseCode</td>
                                <td>@(enrollment.CourseTitle ?? enrollment.CourseCode)</td>
                                <td>@enrollment.TermName (@enrollment.TermCode)</td>
                                <td>@enrollment.AcademicYear</td>
                                <td>@enrollment.Status</td>
                                <td>@enrollment.Credits</td>
                                <td>@enrollment.GradeType</td>
                                <td>@GetGradeDisplay(enrollment)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (studentId is not null)
    {
        <div class="button-row" style="margin-top: 1rem;">
            <a href="@GetTranscriptUrl()" class="button button-primary" target="_blank" rel="noopener noreferrer">
                Download transcript PDF
            </a>
        </div>
    }
}

@code {
    [Parameter, EditorRequired]
    public int UserId { get; set; }

    [Inject]
    private HttpClient Http { get; set; } = default!;

    private bool isLoading = true;
    private string? loadError;
    private string? studentId;
    private List<TermEnrollmentResponse> currentEnrollments = [];
    private List<TermEnrollmentResponse> pastEnrollments = [];
    private StudentStatisticResponse? wam;
    private StudentStatisticResponse? gpa;
    private decimal? creditPointsGained;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        loadError = null;
        try
        {
            var student = await Http.GetFromJsonAsync<StudentProfileResponse>($"api/students/by-user/{UserId}");
            if (student is null)
            {
                loadError = "Profile not found.";
                return;
            }

            studentId = student.StudentId;
            var wamTask = Http.GetFromJsonAsync<StudentStatisticResponse>($"api/students/{Uri.EscapeDataString(student.StudentId)}/wam");
            var gpaTask = Http.GetFromJsonAsync<StudentStatisticResponse>($"api/students/{Uri.EscapeDataString(student.StudentId)}/gpa");
            await Task.WhenAll(wamTask, gpaTask);
            wam = await wamTask;
            gpa = await gpaTask;

            var today = DateOnly.FromDateTime(DateTime.UtcNow);
            currentEnrollments = [];
            pastEnrollments = [];

            foreach (var enrollment in student.Enrollments)
            {
                var startDate = GetTermStartDate(enrollment.AcademicYear, enrollment.StartWeekOfYear);
                var endDate = GetTermEndDate(enrollment.AcademicYear, enrollment.StartWeekOfYear, enrollment.EndWeekOfYear);
                if (startDate is not null && (endDate is null || today <= endDate))
                {
                    currentEnrollments.Add(enrollment);
                }
                else
                {
                    pastEnrollments.Add(enrollment);
                }
            }

            currentEnrollments = currentEnrollments
                .OrderBy(enrollment => GetTermStartDate(enrollment.AcademicYear, enrollment.StartWeekOfYear))
                .ThenBy(enrollment => enrollment.CourseCode)
                .ToList();
            pastEnrollments = pastEnrollments
                .OrderBy(enrollment => GetTermStartDate(enrollment.AcademicYear, enrollment.StartWeekOfYear))
                .ThenBy(enrollment => enrollment.CourseCode)
                .ToList();

            creditPointsGained = student.Enrollments
                .Where(enrollment => enrollment.Status is "Passed" or "Completed")
                .Sum(enrollment => enrollment.Credits ?? 0m);
        }
        catch (HttpRequestException exception)
        {
            loadError = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static DateOnly? GetTermStartDate(int academicYear, int startWeekOfYear)
    {
        if (startWeekOfYear <= 0 || startWeekOfYear > ISOWeek.GetWeeksInYear(academicYear))
        {
            return null;
        }

        return DateOnly.FromDateTime(ISOWeek.ToDateTime(academicYear, startWeekOfYear, DayOfWeek.Monday));
    }

    private static string GetGradeDisplay(TermEnrollmentResponse enrollment) =>
        enrollment.GradeType is "Pass/Fail" or "Ungraded"
            ? "N/A"
            : enrollment.Status is "Completed" or "Passed" or "Failed"
                ? enrollment.GradeValue?.ToString() ?? "N/A"
                : "Pending";

    private string FormatCreditPoints() => creditPointsGained?.ToString("0.##", CultureInfo.InvariantCulture) ?? "N/A";

    private static string FormatStatistic(decimal? value) => value?.ToString("0.00", CultureInfo.InvariantCulture) ?? "N/A";

    private string GetTranscriptUrl()
    {
        var baseAddress = Http.BaseAddress
            ?? throw new InvalidOperationException("The Academic Records API base address is not configured.");
        var relativeUrl = $"api/students/{Uri.EscapeDataString(studentId!)}/transcript.pdf";
        return new Uri(baseAddress, relativeUrl).ToString();
    }

    private static DateOnly? GetTermEndDate(int academicYear, int startWeekOfYear, int endWeekOfYear)
    {
        if (endWeekOfYear <= 0 || endWeekOfYear > 53)
        {
            return null;
        }

        var endYear = endWeekOfYear < startWeekOfYear ? academicYear + 1 : academicYear;
        var weeksInYear = ISOWeek.GetWeeksInYear(endYear);
        var week = Math.Min(endWeekOfYear, weeksInYear);
        var endOfWeek = ISOWeek.ToDateTime(endYear, week, DayOfWeek.Sunday);
        return DateOnly.FromDateTime(endOfWeek);
    }

    private sealed record StudentProfileResponse(int UserId, string StudentId, string FirstName, string LastName, string Email,
        DateOnly? DateOfBirth, string? PhoneNumber, string MailingAddress, string EmergencyContactName,
        string EmergencyContactPhone, DateOnly? EnrollmentDate, string? Degree, string? Major, string? SubMajor,
        List<TermEnrollmentResponse> Enrollments, DateOnly? GraduationDate = null);

    private sealed record TermEnrollmentResponse(int EnrollmentId, string CourseCode, string? CourseTitle, int? AcademicTermId, string? TermCode,
        string? TermName, int StartWeekOfYear, int EndWeekOfYear, int AcademicYear, string Status, decimal? Credits, string GradeType, decimal? GradeValue);

    private sealed record StudentStatisticResponse(string StudentId, string Statistic, decimal? Value,
        int GradedEnrollmentCount, decimal TotalCredits);
}
