@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<CampusShell PageName="Academic Records"
             SectionLabel="Registrar services"
             UserName="Academic Records"
             UserDetails="Enrollment and graduation workspace"
             UserInitials="AR"
             HomeHref="http://localhost:8080"
             PortalHref="http://localhost:8080"
             ContextLabel="Academic records workspace">
    <ChildContent>
        @Body
    </ChildContent>
</CampusShell>

<CampusAiChat StudentUserId="@CurrentStudentUserId" />

@code {
    private int? CurrentStudentUserId
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', 2)[0];
            var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);

            return segments.Length == 2
                && string.Equals(segments[0], "students", StringComparison.OrdinalIgnoreCase)
                && int.TryParse(segments[1], out var userId)
                && userId > 0
                    ? userId
                    : null;
        }
    }

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) =>
        _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
