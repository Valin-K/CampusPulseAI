@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject AccountService Account

<CampusShell PageName="Academic Records"
             SectionLabel="Registrar services"
             UserName="@(Account.CurrentUser?.FullName ?? "Academic Records")"
             UserDetails="@(Account.CurrentUser is null ? "Enrollment and graduation workspace" : $"{Account.CurrentUser.Role} · {Account.CurrentUser.ExternalId}")"
             UserInitials="@(Account.CurrentUser?.Initials ?? "AR")"
             HomeHref="http://localhost:8080"
             PortalHref="http://localhost:8080"
             RequireSignedInUser="true"
             ContextLabel="@(Account.CurrentUser is null ? "Academic records workspace" : $"{Account.CurrentUser.Role} account")">
    <ChildContent>
        @Body
    </ChildContent>
</CampusShell>

<CampusAiChat StudentUserId="@CurrentStudentUserId" />

@code {
    private int? CurrentStudentUserId
    {
        get
        {
            var user = Account.CurrentUser;
            return user is not null
                && AccountService.IsStudent(user)
                && user.UserId > 0
                    ? user.UserId
                    : null;
        }
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Account.Changed += OnAccountChanged;
    }

    protected override async Task OnInitializedAsync() => await Account.InitializeAsync();

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnAccountChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Account.Changed -= OnAccountChanged;
    }
}
