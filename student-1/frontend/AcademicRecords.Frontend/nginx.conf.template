server {
    listen       80;
    listen  [::]:80;
    server_name  localhost;

    root   /usr/share/nginx/html;
    index  index.html;

    resolver 127.0.0.11 valid=10s;
    proxy_ssl_server_name on;

    location = /campus-config.json {
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }

    location /api/ {
        set $backend_upstream ${BACKEND_BASE_URL};
        proxy_pass $backend_upstream$request_uri;
        # Azure Container Apps' internal ingress routes by Host header too, not just SNI;
        # forwarding the original client Host (this frontend's own hostname) makes Envoy
        # unable to match the backend app, returning its platform "Unavailable" page.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /_framework/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location /js/ {
        add_header Cache-Control "no-cache";
    }
}
