@inherits LayoutComponentBase
@inject HousingUserContext UserContext
@using Microsoft.JSInterop

<CampusShell PageName="Campus Housing"
             SectionLabel="Housing services"
             UserName="@(UserContext.CurrentUser?.DisplayName ?? "")"
             UserDetails="@(UserContext.CurrentUser is null ? "" : UserContext.IsAdministrator ? "Housing Administrator" : $"Student ID: {UserContext.CurrentUser.StudentId}")"
             UserInitials="@(UserContext.IsAdministrator ? "HA" : "JW")"
             HomeHref="http://localhost:8080"
             PortalHref="http://localhost:8080"
             ContextLabel="@ContextLabel">
    <UserSelector>
        <div class="housing-user-selector">
            @if (!UserContext.IsInitialized)
            {
                <span role="status">Verifying Housing access...</span>
            }
            else if (UserContext.IsAvailable)
            {
                <label for="housing-user-select">Viewing as</label>
                <select id="housing-user-select"
                        value="@UserContext.CurrentUser!.UserId"
                        @onchange="ChangeUserAsync"
                        aria-label="Select demonstration housing user">
                    @foreach (var user in UserContext.Users)
                    {
                        <option value="@user.UserId">@user.DisplayName (@DisplayRole(user))</option>
                    }
                </select>
            }
            else
            {
                <span>Housing access unavailable</span>
            }
        </div>
    </UserSelector>
    <ChildContent>
        @if (!UserContext.IsInitialized)
        {
            <LoadingIndicator Message="Verifying Housing access..." />
        }
        else if (!UserContext.IsAvailable)
        {
            <FeedbackPanel Kind="FeedbackKind.Error"
                           Title="Housing access unavailable"
                           Message="@(UserContext.ErrorMessage ?? "Housing access could not be verified.")">
                <button class="btn btn-outline-danger" @onclick="RetryAsync">Try again</button>
            </FeedbackPanel>
        }
        else
        {
            @if (selectionErrorMessage is not null)
            {
                <FeedbackPanel Kind="FeedbackKind.Error"
                               Title="User selection could not be saved"
                               Message="@selectionErrorMessage" />
            }

            @Body
        }
    </ChildContent>
</CampusShell>

<CampusAiChat />

@code {
    string? selectionErrorMessage;

    string ContextLabel => UserContext.CurrentUser is null
        ? "Housing services workspace"
        : $"{DisplayRole(UserContext.CurrentUser)} housing workspace";

    protected override async Task OnInitializedAsync()
    {
        await UserContext.InitializeAsync();
    }

    async Task ChangeUserAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var userId))
        {
            selectionErrorMessage = null;
            try
            {
                await UserContext.SelectUserAsync(userId);
            }
            catch (JSException)
            {
                selectionErrorMessage =
                    "This browser did not allow the selected user to be saved. Try again or use another browser window.";
            }
            catch (InvalidOperationException)
            {
                selectionErrorMessage =
                    "The selected user is no longer available. Refresh Campus Housing and try again.";
            }
        }
    }

    async Task RetryAsync()
    {
        await UserContext.InitializeAsync(forceRefresh: true);
    }

    static string DisplayRole(HousingUser user) =>
        user.IsAdministrator ? "Staff" : "Student";
}
