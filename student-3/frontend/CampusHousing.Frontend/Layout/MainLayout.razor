@inherits LayoutComponentBase
@inject HousingUserContext UserContext
@inject AccountService Account

<CampusShell PageName="Campus Housing"
             SectionLabel="Housing services"
             UserName="@(Account.CurrentUser?.FullName ?? "Campus Housing")"
             UserDetails="@(Account.CurrentUser is null ? "Housing workspace" : $"{Account.CurrentUser.Role} · {Account.CurrentUser.ExternalId}")"
             UserInitials="@(Account.CurrentUser?.Initials ?? "CH")"
             HomeHref="http://localhost:8080"
             PortalHref="http://localhost:8080"
             RequireSignedInUser="true"
             ContextLabel="@ContextLabel">
    <ChildContent>
        @if (!UserContext.IsInitialized)
        {
            <LoadingIndicator Message="Verifying Housing access..." />
        }
        else if (!UserContext.IsAvailable)
        {
            <FeedbackPanel Kind="FeedbackKind.Error"
                           Title="Housing access unavailable"
                           Message="@(UserContext.ErrorMessage ?? "Housing access could not be verified.")">
                <button class="btn btn-outline-danger" @onclick="RetryAsync">Try again</button>
            </FeedbackPanel>
        }
        else
        {
            @Body
        }
    </ChildContent>
</CampusShell>

@if (Account.CurrentUser is not null)
{
    <CampusAiChat StudentUserId="@UserContext.CurrentUser?.UserId" />
}

@code {
    string ContextLabel => UserContext.CurrentUser is null
        ? "Housing services workspace"
        : $"{(UserContext.IsAdministrator ? "Staff" : "Student")} housing workspace";

    protected override async Task OnInitializedAsync()
    {
        await Account.InitializeAsync();
        await UserContext.InitializeAsync();
    }

    async Task RetryAsync()
    {
        await UserContext.InitializeAsync(forceRefresh: true);
    }
}
