@page "/"
@using System.Net.Http.Json
@using CampusHousing.Frontend.Models
@using CampusPulse.Shared.Components.Models
@inject HttpClient Http
@inject HousingUserContext UserContext

<PageTitle>The Residence | Campus Housing</PageTitle>

<header class="dashboard-hero">
    <div>
        <span class="eyebrow">The residence</span>
        <h1>Campus housing & maintenance</h1>
        <p>Submit a housing request, check room availability, or report a maintenance issue.</p>
    </div>
    <div class="term-summary"><span>Current demo user</span><strong>@UserContext.CurrentUser?.DisplayName</strong><small>@(UserContext.IsAdministrator ? "Housing Administrator" : UserContext.CurrentUser?.StudentId)</small></div>
</header>

<section class="metric-grid" aria-label="Housing summary">
    <CampusMetricCard Label="Available rooms" Value="@AvailableRoomCount.ToString()" Detail="Rooms with open beds" />
    <CampusMetricCard Label="Housing requests" Value="@allocations.Count.ToString()" Detail="Submitted room allocations" Tone="green" />
    <CampusMetricCard Label="Open tickets" Value="@OpenTicketCount.ToString()" Detail="Maintenance requests in queue" Tone="gold" />
</section>

@if (!string.IsNullOrWhiteSpace(message)) { <div class="notice notice-success" role="status">@message</div> }

<CampusSectionTabs Items="sections" @bind-ActiveKey="activeTab" AriaLabel="Housing sections" />

@if (activeTab == "submit")
{
    <div class="content-grid">
        <section class="surface-card">
            <div class="section-heading"><div><span class="eyebrow">Room allocation</span><h2>Request a room</h2><p class="section-summary">Select a room and roommate preferences.</p></div></div>
            <div class="form-stack">
                <label class="field"><span>Student name</span><input @bind="studentName" /></label>
                <label class="field"><span>Student ID</span><input @bind="studentId" /></label>
                <label class="field"><span>Room</span><select @bind="roomId"><option value="0">Choose an available room</option>@foreach (var room in rooms.Where(r => r.IsAvailable && r.OccupiedBeds < r.Capacity)) { <option value="@room.Id">@room.Building @room.RoomNumber · @(room.Capacity - room.OccupiedBeds) bed(s) free</option> }</select></label>
                <label class="field"><span>Roommate preference</span><input @bind="roommatePreference" placeholder="Quiet, social, any..." /></label>
                <div class="button-row"><button class="button button-primary" @onclick="BookRoomAsync" disabled="@busy">Submit room request</button></div>
            </div>
        </section>
        <section class="surface-card">
            <div class="section-heading"><div><span class="eyebrow">Maintenance support</span><h2>Report an issue</h2><p class="section-summary">AI triage of maintenance requests.</p></div></div>
            <div class="form-stack">
                <label class="field"><span>Issue description</span><textarea @bind="description" rows="5" placeholder="e.g. The heater is broken and the room is very cold"></textarea></label>
                <label class="field"><span>Your student ID</span><input @bind="ticketStudentId" /></label>
                <div class="button-row"><button class="button button-accent" @onclick="SubmitTicketAsync" disabled="@busy">Submit ticket</button></div>
            </div>
        </section>
    </div>
    <section class="surface-card table-panel"><div class="section-heading"><div><span class="eyebrow">Residence inventory</span><h2>Room availability</h2></div></div><div class="room-cards">@foreach (var room in rooms) { <div class="room-card"><strong>@room.Building @room.RoomNumber</strong><span>@room.OccupiedBeds / @room.Capacity occupied</span><span class="@(room.IsAvailable && room.OccupiedBeds < room.Capacity ? "available" : "full")">@(room.IsAvailable && room.OccupiedBeds < room.Capacity ? "Available" : "Full")</span></div> }</div></section>
}
else if (activeTab == "allocations")
{
    <section class="surface-card table-panel"><div class="section-heading"><div><span class="eyebrow">Room allocation history</span><h2>@(UserContext.IsAdministrator ? "All submitted housing requests" : "My submitted housing requests")</h2></div></div>
        @if (allocations.Count == 0) { <p class="muted">No housing requests have been submitted.</p> }
        else { <div class="responsive-table"><table><thead><tr><th>Student</th><th>Room</th><th>Allocated</th><th>Roommate preference</th><th></th></tr></thead><tbody>@foreach (var allocation in allocations) { <tr><td><strong>@allocation.StudentName</strong><small>@allocation.StudentId</small></td><td>@if (UserContext.IsAdministrator) { <select @bind="allocation.DormRoomId">@foreach (var room in rooms.Where(room => room.IsAvailable || room.Id == allocation.DormRoomId)) { <option value="@room.Id">@RoomName(room.Id)</option> }</select> } else { @RoomName(allocation.DormRoomId) }</td><td>@allocation.AllocatedAt.ToLocalTime().ToString("MMM d, yyyy")</td><td>@if (UserContext.IsAdministrator) { <input class="inline-input" @bind="allocation.RoommatePreference" /> } else { @allocation.RoommatePreference }</td><td>@if (UserContext.IsAdministrator) { <div class="button-row"><button class="button button-small button-primary" @onclick="() => UpdateAllocationAsync(allocation)">Save</button><button class="button button-small button-danger" @onclick="() => DeleteAllocationAsync(allocation.Id)">Cancel</button></div> }</td></tr> }</tbody></table></div> }
    </section>
}
else
{
    <section class="surface-card table-panel"><div class="section-heading"><div><span class="eyebrow">Service desk</span><h2>@(UserContext.IsAdministrator ? "All submitted maintenance tickets" : "My submitted maintenance tickets")</h2></div></div>
        @if (tickets.Count == 0) { <p class="muted">No maintenance tickets have been submitted.</p> }
        else { <div class="responsive-table"><table><thead><tr><th>Request</th><th>AI severity</th><th>Repair queue</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var ticket in tickets) { <tr><td><strong>@ticket.Description</strong><small>@ticket.StudentId · @ticket.CreatedAt.ToLocalTime().ToString("g")</small></td><td>@if (UserContext.IsAdministrator) { <select @bind="ticket.Severity"><option>Emergency</option><option>High</option><option>Medium</option><option>Low</option></select> } else { @ticket.Severity }</td><td>@if (UserContext.IsAdministrator) { <select @bind="ticket.RepairQueue"><option>Heating</option><option>Plumbing</option><option>Electrical</option><option>Security</option><option>General Maintenance</option></select> } else { @ticket.RepairQueue }</td><td>@if (UserContext.IsAdministrator) { <select @bind="ticket.Status"><option>Open</option><option>In Progress</option><option>Resolved</option></select> } else { @ticket.Status }</td><td>@if (UserContext.IsAdministrator) { <div class="button-row"><button class="button button-small button-primary" @onclick="() => UpdateTicketAsync(ticket)">Save</button><button class="button button-small button-danger" @onclick="() => DeleteTicketAsync(ticket.Id)">Delete</button></div> }</td></tr> }</tbody></table></div> }
    </section>
}

@if (reallocation is not null)
{
    <div class="modal-backdrop" @onclick="CancelReallocation"><section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="reallocation-title" @onclick:stopPropagation="true"><h2 id="reallocation-title">Reallocate your room?</h2><p>You are currently allocated to @RoomName(reallocation.DormRoomId). Are you sure you want to reallocate your room to @RoomName(roomId)?</p><div class="button-row"><button class="button button-secondary" @onclick="CancelReallocation">Cancel</button><button class="button button-primary" @onclick="ConfirmReallocationAsync">Yes, reallocate</button></div></section></div>
}

@code {
    private static readonly IReadOnlyList<CampusTabItem> sections =
    [
        new("submit", "Submit requests", "Book a room or report an issue"),
        new("allocations", "Housing requests", "Review submitted room requests"),
        new("tickets", "Maintenance tickets", "Track repair requests")
    ];
    private string activeTab = "submit", studentName = "", studentId = "", ticketStudentId = "", roommatePreference = "", description = "", message = "";
    private int roomId; private bool busy;
    private List<DormRoom> rooms = []; private List<HousingAllocation> allocations = []; private List<MaintenanceTicket> tickets = [];
    private HousingAllocation? reallocation;

    private int AvailableRoomCount => rooms.Count(room => room.IsAvailable && room.OccupiedBeds < room.Capacity);
    private int OpenTicketCount => tickets.Count(ticket => !string.Equals(ticket.Status, "Resolved", StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() { try { rooms = await Http.GetFromJsonAsync<List<DormRoom>>("api/housing/rooms") ?? []; allocations = await Http.GetFromJsonAsync<List<HousingAllocation>>("api/housing/allocations") ?? []; tickets = await Http.GetFromJsonAsync<List<MaintenanceTicket>>("api/housing/tickets") ?? []; } catch (Exception ex) { message = $"Residence API unavailable: {ex.Message}"; } }
    private string RoomName(int id) => rooms.FirstOrDefault(r => r.Id == id) is { } room ? $"{room.Building} {room.RoomNumber}" : $"Room {id}";
    private async Task BookRoomAsync() { if (roomId == 0 || string.IsNullOrWhiteSpace(studentId) || string.IsNullOrWhiteSpace(studentName)) { message = "Choose a room and provide your student details."; return; } var current = allocations.FirstOrDefault(a => a.StudentId.Equals(studentId, StringComparison.OrdinalIgnoreCase)); if (current is not null && !UserContext.IsAdministrator) { reallocation = current; return; } await SendAsync(HttpMethod.Post, "api/housing/allocations", new { DormRoomId = roomId, StudentId = studentId, StudentName = studentName, RoommatePreference = roommatePreference }, "Room allocation submitted."); }
    private void CancelReallocation() => reallocation = null;
    private async Task ConfirmReallocationAsync() { if (reallocation is null) return; await SendAsync(HttpMethod.Put, $"api/housing/allocations/{reallocation.Id}", new { DormRoomId = roomId, reallocation.StudentId, reallocation.StudentName, reallocation.RoommatePreference }, "Room reallocated."); reallocation = null; }
    private async Task SubmitTicketAsync() { if (string.IsNullOrWhiteSpace(ticketStudentId) || string.IsNullOrWhiteSpace(description)) { message = "Student ID and issue description are required."; return; } await SendAsync(HttpMethod.Post, "api/housing/tickets", new { StudentId = ticketStudentId, Description = description }, "Request routed successfully."); }
    private async Task UpdateAllocationAsync(HousingAllocation a) => await SendAsync(HttpMethod.Put, $"api/housing/allocations/{a.Id}", new { a.DormRoomId, a.StudentId, a.StudentName, a.RoommatePreference }, "Allocation updated.");
    private async Task DeleteAllocationAsync(int id) => await SendAsync(HttpMethod.Delete, $"api/housing/allocations/{id}", null, "Allocation cancelled.");
    private async Task UpdateTicketAsync(MaintenanceTicket t) => await SendAsync(HttpMethod.Put, $"api/housing/tickets/{t.Id}", new { t.Status, t.Severity, t.RepairQueue }, "Ticket updated.");
    private async Task DeleteTicketAsync(int id) => await SendAsync(HttpMethod.Delete, $"api/housing/tickets/{id}", null, "Maintenance ticket deleted.");
    private async Task SendAsync(HttpMethod method, string url, object? body, string success) { busy = true; try { using var request = new HttpRequestMessage(method, url); if (body is not null) request.Content = JsonContent.Create(body); using var response = await Http.SendAsync(request); message = response.IsSuccessStatusCode ? success : await response.Content.ReadAsStringAsync(); } catch (Exception ex) { message = ex.Message; } finally { busy = false; await LoadAsync(); } }
}