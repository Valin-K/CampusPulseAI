@page "/maintenance"
@using CampusHousing.Frontend.Models
@inject HttpClient Http
@inject HousingUserContext UserContext

<PageTitle>Maintenance | Campus Housing</PageTitle>

<header class="dashboard-hero housing-header">
    <div><span class="eyebrow">THE RESIDENCE</span><h1>Maintenance requests</h1><p>Report issues, review AI triage, and follow repair progress.</p></div>
</header>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="notice" role="status">@message</div>
}

<div class="housing-grid">
    <section class="card-panel accent-panel">
        <h2>Report an issue</h2>
        <p class="muted">The residence assistant categorizes urgency and routes your request.</p>
        <EditForm Model="draft" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />
            <label>Student ID <InputText @bind-Value="draft.StudentId" /></label>
            <label>Room <select @bind="draft.DormRoomId"><option value="">Not specified</option>@foreach (var room in rooms) { <option value="@room.Id">@room.Building @room.RoomNumber</option> }</select></label>
            <label>Issue description <InputTextArea @bind-Value="draft.Description" rows="5" /></label>
            <button type="submit" disabled="@busy">@(busy ? "Submitting..." : "Submit request")</button>
        </EditForm>
    </section>

    <section class="card-panel table-panel">
        <h2>Request history</h2>
        @if (loading)
        {
            <p class="muted">Loading requests...</p>
        }
        else if (tickets.Count == 0)
        {
            <p class="muted">No maintenance requests have been submitted.</p>
        }
        else
        {
            <div class="table-responsive"><table><thead><tr><th>Request</th><th>Severity</th><th>Queue</th><th>Status</th><th>Actions</th></tr></thead><tbody>
                @foreach (var ticket in tickets)
                {
                    <tr><td><strong>@ticket.Description</strong><br /><small>@ticket.StudentId · @ticket.CreatedAt.ToLocalTime().ToString("g")</small></td><td>@if (UserContext.IsAdministrator) { <select class="status-select" @bind="ticket.Severity"><option>Emergency</option><option>High</option><option>Medium</option><option>Low</option></select> } else { <span class="severity @ticket.Severity.ToLowerInvariant()">@ticket.Severity</span> }</td><td>@if (UserContext.IsAdministrator) { <select class="status-select" @bind="ticket.RepairQueue"><option>Heating</option><option>Plumbing</option><option>Electrical</option><option>Security</option><option>General Maintenance</option></select> } else { @ticket.RepairQueue }</td><td>@if (UserContext.IsAdministrator) { <select class="status-select" @bind="ticket.Status"><option>Open</option><option>In Progress</option><option>Resolved</option></select> } else { @ticket.Status }</td><td>@if (UserContext.IsAdministrator) { <button class="link-button" @onclick="() => UpdateAsync(ticket)">Save</button><button class="link-button danger" @onclick="() => DeleteAsync(ticket.Id)">Delete</button> }</td></tr>
                }
            </tbody></table></div>
        }
    </section>
</div>

@code {
    private List<DormRoom> rooms = [];
    private List<MaintenanceTicket> tickets = [];
    private TicketDraft draft = new();
    private string message = "";
    private bool loading = true;
    private bool busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            var roomsTask = Http.GetFromJsonAsync<List<DormRoom>>("api/housing/rooms");
            var ticketsTask = Http.GetFromJsonAsync<List<MaintenanceTicket>>("api/housing/tickets");
            await Task.WhenAll(roomsTask, ticketsTask);
            rooms = await roomsTask ?? [];
            tickets = await ticketsTask ?? [];
        }
        catch (Exception ex) { message = $"Maintenance requests could not be loaded: {ex.Message}"; }
        finally { loading = false; }
    }

    private async Task SubmitAsync()
    {
        busy = true;
        try
        {
            using var response = await Http.PostAsJsonAsync("api/housing/tickets", draft);
            message = response.IsSuccessStatusCode ? "Request routed successfully." : await response.Content.ReadAsStringAsync();
            if (response.IsSuccessStatusCode) draft = new();
        }
        catch (Exception ex) { message = ex.Message; }
        finally { busy = false; await LoadAsync(); }
    }

    private async Task UpdateAsync(MaintenanceTicket ticket) => await SendAsync(HttpMethod.Put, $"api/housing/tickets/{ticket.Id}", new { ticket.Status, ticket.Severity, ticket.RepairQueue }, "Ticket updated.");
    private async Task ChangeStatusAsync(MaintenanceTicket ticket, string? status) => await SendAsync(HttpMethod.Put, $"api/housing/tickets/{ticket.Id}", new { Status = status }, "Ticket status updated.");
    private async Task DeleteAsync(int id) => await SendAsync(HttpMethod.Delete, $"api/housing/tickets/{id}", null, "Maintenance ticket deleted.");

    private async Task SendAsync(HttpMethod method, string url, object? body, string success)
    {
        try
        {
            using var request = new HttpRequestMessage(method, url);
            if (body is not null) request.Content = JsonContent.Create(body);
            using var response = await Http.SendAsync(request);
            message = response.IsSuccessStatusCode ? success : await response.Content.ReadAsStringAsync();
            await LoadAsync();
        }
        catch (Exception ex) { message = ex.Message; }
    }

    private sealed class TicketDraft
    {
        public string StudentId { get; set; } = "";
        public int? DormRoomId { get; set; }
        public string Description { get; set; } = "";
    }
}
