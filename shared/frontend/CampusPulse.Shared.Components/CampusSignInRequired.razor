@inject CampusAccountService Account
@inject NavigationManager Navigation

<PageTitle>Sign in required | CampusPulse</PageTitle>

<section class="surface-card campus-sign-in-required" aria-labelledby="sign-in-required-heading">
    <span class="eyebrow">Session required</span>
    <h1 id="sign-in-required-heading">Sign in to continue</h1>
    @if (Account.ErrorMessage is { } errorMessage)
    {
        <div class="notice notice-error" role="alert">Unable to verify your sign-in session: @errorMessage</div>
    }
    else
    {
        <p>No signed-in user was found for this browser session.</p>
    }
    <p>Sign in with your student or staff account to access this page.</p>
    <a class="button button-primary" href="@SignInUrl">Go to sign in</a>
</section>

@code {
    private string SignInUrl => $"http://localhost:8081/login?returnUrl={Uri.EscapeDataString(Navigation.Uri)}";
}
