<header class="campus-topbar">
    <a class="campus-brand" href="@HomeHref" aria-label="CampusPulse home">
        <span class="campus-mark" aria-hidden="true">CP</span>
        <span class="campus-brand-copy"><strong>CampusPulse</strong><small>University services</small></span>
    </a>

    <span class="campus-divider" aria-hidden="true"></span>

    <div class="campus-app-name">
        <span>@SectionLabel</span>
        <strong>@PageName</strong>
    </div>

    <nav class="campus-global-nav" aria-label="Application navigation">
        <a href="@PortalHref">All services</a>
    </nav>

    <div class="campus-user" aria-label="Current student">
        <span class="campus-avatar" aria-hidden="true">@UserInitials</span>
        <span><strong>@UserName</strong><small>@UserDetails</small></span>
    </div>
</header>

<div class="campus-context-bar">
    <span><i aria-hidden="true"></i> Student portal</span>
</div>

@code {
    [Parameter, EditorRequired] public string PageName { get; set; } = string.Empty;
    [Parameter] public string SectionLabel { get; set; } = "Student services";
    [Parameter] public string UserName { get; set; } = "Student";
    [Parameter] public string UserDetails { get; set; } = string.Empty;
    [Parameter] public string UserInitials { get; set; } = "ST";
    [Parameter] public string HomeHref { get; set; } = "/";
    [Parameter] public string PortalHref { get; set; } = "http://localhost:8080";
}
