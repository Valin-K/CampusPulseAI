@inherits LayoutComponentBase
@implements IDisposable
@inject CampusAccountService Account
@inject NavigationManager Navigation

<CampusShell PageName="CampusPulse Account"
             SectionLabel="Account access"
             UserName="@(Account.CurrentUser?.FullName ?? "CampusPulse account")"
             UserDetails="@(Account.CurrentUser is null ? "Student and staff sign-in" : $"{Account.CurrentUser.Role} · {Account.CurrentUser.ExternalId}")"
             UserInitials="@(Account.CurrentUser?.Initials ?? "CP")"
             HomeHref="/"
             PortalHref="http://localhost:8080"
             ShowAccountActions="@ShowAccountActions"
             ContextLabel="@(Account.CurrentUser is null ? "Sign in to CampusPulse" : $"Signed in as {Account.CurrentUser.Role}")">
    <ChildContent>
        @Body
    </ChildContent>
</CampusShell>

@code {
    private bool ShowAccountActions => !string.Equals(
        Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', 2)[0].Trim('/'),
        "login",
        StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Account.Changed += AccountChanged;
        Navigation.LocationChanged += LocationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await Account.InitializeAsync();
    }

    private void AccountChanged() => _ = InvokeAsync(StateHasChanged);

    private void LocationChanged(object? sender, LocationChangedEventArgs args) =>
        _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Account.Changed -= AccountChanged;
        Navigation.LocationChanged -= LocationChanged;
    }
}
