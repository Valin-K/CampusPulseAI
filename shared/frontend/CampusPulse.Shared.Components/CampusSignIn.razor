@page "/login"
@page "/login/{Role}"
@layout CampusAccountLayout
@implements IDisposable
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@inject AccountService Account
@inject NavigationManager Navigation

<PageTitle>Sign in | CampusPulse</PageTitle>

<div class="campus-account-sign-in">
        <header class="dashboard-hero account-sign-in-hero">
            <div>
                <span class="eyebrow">CampusPulse account</span>
                <h1>@SignInHeading</h1>
                <p>@SignInDescription</p>
            </div>
            <div class="term-summary">
                <span>CampusPulse account</span>
                <strong>Student and staff access</strong>
                <small>Sign in or create an account</small>
            </div>
        </header>

        @if (!Account.IsInitialized)
        {
            <p class="muted" role="status">Checking your sign-in session...</p>
        }
        else if (Account.CurrentUser is { } user
            && (string.IsNullOrWhiteSpace(Role)
                || string.Equals(user.Role, NormalizedRole, StringComparison.OrdinalIgnoreCase)))
        {
            <div class="notice notice-success" role="status">
                Signed in as <strong>@user.FullName</strong> (@user.Role).
            </div>
            <a class="button button-primary" href="@SafeReturnUrl">Continue to CampusPulse</a>
        }
        else if (Account.CurrentUser is { } roleMismatchUser)
        {
            <div class="notice notice-error" role="alert">
                This CampusPulse account is linked as @roleMismatchUser.Role, not @NormalizedRole.
            </div>
            <a class="button button-secondary" href="@SignInUrl">Choose another sign-in option</a>
        }
        else if (creatingAccount
            && !string.IsNullOrWhiteSpace(Role))
        {
            <section class="surface-card account-registration-panel">
                <div class="section-heading">
                    <div>
                        <span class="eyebrow">New @NormalizedRole.ToLowerInvariant()</span>
                        <h2>Create a @NormalizedRole.ToLowerInvariant() account</h2>
                    </div>
                    <button type="button" class="button button-secondary" @onclick="() => creatingAccount = false">Back</button>
                </div>
                @if (registrationError is not null)
                {
                    <div class="notice notice-error" role="alert">@registrationError</div>
                }
                @if (IsStudentRole)
                {
                    <EditForm Model="studentRegistration" OnValidSubmit="CreateStudentAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="form-grid">
                            <label class="field"><span>First name</span><InputText @bind-Value="studentRegistration.FirstName" /></label>
                            <label class="field"><span>Last name</span><InputText @bind-Value="studentRegistration.LastName" /></label>
                            <label class="field"><span>Email</span><InputText type="email" @bind-Value="studentRegistration.Email" /></label>
                            <label class="field"><span>Date of birth</span><InputDate @bind-Value="studentRegistration.DateOfBirth" /></label>
                            <label class="field"><span>Phone number</span><InputText @bind-Value="studentRegistration.PhoneNumber" /></label>
                            <label class="field"><span>Mailing address</span><InputText @bind-Value="studentRegistration.MailingAddress" /></label>
                            <label class="field"><span>Emergency contact name</span><InputText @bind-Value="studentRegistration.EmergencyContactName" /></label>
                            <label class="field"><span>Emergency contact phone</span><InputText @bind-Value="studentRegistration.EmergencyContactPhone" /></label>
                            <label class="field"><span>Password</span><InputText type="password" autocomplete="new-password" @bind-Value="studentRegistration.Password" /></label>
                            <label class="field"><span>Confirm password</span><InputText type="password" autocomplete="new-password" @bind-Value="studentRegistration.ConfirmPassword" /></label>
                            <label class="field"><span>Degree</span><InputText @bind-Value="studentRegistration.Degree" /></label>
                            <label class="field"><span>Major</span><InputText @bind-Value="studentRegistration.Major" /></label>
                        </div>
                        <div class="button-row" style="margin-top: 1rem;">
                            <button type="submit" class="button button-primary" disabled="@submitting">@(submitting ? "Creating account..." : "Create student account")</button>
                        </div>
                    </EditForm>
                }
                else
                {
                    <EditForm Model="staffRegistration" OnValidSubmit="CreateStaffAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="form-grid">
                            <label class="field"><span>First name</span><InputText @bind-Value="staffRegistration.FirstName" /></label>
                            <label class="field"><span>Last name</span><InputText @bind-Value="staffRegistration.LastName" /></label>
                            <label class="field"><span>Email</span><InputText type="email" @bind-Value="staffRegistration.Email" /></label>
                            <label class="field"><span>Date of birth</span><InputDate @bind-Value="staffRegistration.DateOfBirth" /></label>
                            <label class="field"><span>Phone number</span><InputText @bind-Value="staffRegistration.PhoneNumber" /></label>
                            <label class="field"><span>Password</span><InputText type="password" autocomplete="new-password" @bind-Value="staffRegistration.Password" /></label>
                            <label class="field"><span>Confirm password</span><InputText type="password" autocomplete="new-password" @bind-Value="staffRegistration.ConfirmPassword" /></label>
                        </div>
                        <div class="button-row" style="margin-top: 1rem;">
                            <button type="submit" class="button button-primary" disabled="@submitting">@(submitting ? "Creating account..." : "Create staff account")</button>
                        </div>
                    </EditForm>
                }
            </section>
        }
        else if (Account.IsAuthenticated && Account.CanRegisterAccount)
        {
            <section class="surface-card account-role-selection">
                <h2>@SignInHeading</h2>
                <p>@Account.ErrorMessage</p>
                @if (string.IsNullOrWhiteSpace(Role))
                {
                    <div class="button-row">
                        <a class="button button-primary" href="@RoleSignInUrl("student")">Create student account</a>
                        <a class="button button-secondary" href="@RoleSignInUrl("staff")">Create staff account</a>
                    </div>
                }
                else
                {
                    <button type="button" class="button button-primary" @onclick="BeginCreatingAccount">Create @NormalizedRole.ToLowerInvariant() account</button>
                }
            </section>
        }
        else if (Account.IsAuthenticated)
        {
            <div class="notice notice-error" role="alert">
                @(Account.ErrorMessage ?? "Your university account is not linked to CampusPulse. Contact an administrator.")
            </div>
        }
        else if (string.IsNullOrWhiteSpace(Role))
        {
            <section class="surface-card account-role-selection">
                <h2>Choose your CampusPulse account</h2>
                <p>Continue through the student or staff sign-in experience.</p>
                <div class="button-row">
                    <a class="button button-primary" href="@RoleSignInUrl("student")">Student sign in</a>
                    <a class="button button-secondary" href="@RoleSignInUrl("staff")">Staff sign in</a>
                </div>
            </section>
        }
        else
        {
            <section class="surface-card account-role-selection">
                <h2>@SignInHeading</h2>
                @if (Account.ErrorMessage is not null)
                {
                    <div class="notice notice-error" role="alert">@Account.ErrorMessage</div>
                }
                @if (loginErrorMessage is not null)
                {
                    <div class="notice notice-error" role="alert">@loginErrorMessage</div>
                }
                @if (accountCreatedMessage is not null)
                {
                    <div class="notice notice-success" role="status">@accountCreatedMessage</div>
                }
                <EditForm class="account-login-form" Model="selection" OnValidSubmit="SignInAsync">
                    <DataAnnotationsValidator />
                    <label class="field">
                        <span>@(IsStudentRole ? "Student ID" : "Staff ID")</span>
                        <InputText autocomplete="username" @bind-Value="selection.AccountId" />
                    </label>
                    <label class="field">
                        <span>Password</span>
                        <InputText type="password" autocomplete="current-password" @bind-Value="selection.Password" />
                    </label>
                    <button type="submit" class="button button-primary" disabled="@submitting">
                        @(submitting ? "Logging in..." : "Login")
                    </button>
                </EditForm>
                <button type="button" class="button button-secondary account-login-create" @onclick="BeginCreatingAccount">Create @NormalizedRole.ToLowerInvariant() account</button>
            </section>
        }
</div>

@code {
    [Parameter] public string? Role { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }
    [Inject] private AuthenticationStateProvider Authentication { get; set; } = default!;

    private string NormalizedRole => string.Equals(Role, "staff", StringComparison.OrdinalIgnoreCase)
        ? "Staff"
        : "Student";
    private string SignInHeading => string.IsNullOrWhiteSpace(Role)
        ? "Sign in"
        : $"{NormalizedRole} sign in";
    private string SignInDescription => string.IsNullOrWhiteSpace(Role)
        ? "Use your student or staff account to access CampusPulse services."
        : $"Sign in to access CampusPulse {NormalizedRole.ToLowerInvariant()} services.";
    private string SafeReturnUrl => IsAllowedReturnUrl(ReturnUrl) ? ReturnUrl! : "/";
    private string SignInUrl => RoleSignInUrl(null);
    private bool IsStudentRole => string.Equals(NormalizedRole, "Student", StringComparison.Ordinal);

    private bool creatingAccount;
    private bool submitting;
    private string? loginErrorMessage;
    private string? registrationError;
    private string? accountCreatedMessage;
    private AccountSelection selection = new();
    private StudentRegistrationModel studentRegistration = new();
    private StaffRegistrationModel staffRegistration = new();

    protected override async Task OnInitializedAsync()
    {
        Account.Changed += AccountChanged;
        await Account.InitializeAsync();
    }

    protected override void OnParametersSet()
    {
        selection.AccountId = string.Empty;
        loginErrorMessage = null;
        selection.Password = string.Empty;
    }

    private void AccountChanged() => _ = InvokeAsync(StateHasChanged);

    private void BeginCreatingAccount()
    {
        registrationError = null;
        accountCreatedMessage = null;
        creatingAccount = true;
    }

    private async Task SignInAsync()
    {
        submitting = true;
        loginErrorMessage = null;
        try
        {
            await Authentication.SignInAsync(selection.AccountId, NormalizedRole, selection.Password);
            await Account.InitializeAsync(forceRefresh: true);
            Navigation.NavigateTo(BuildReturnUrl());
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or InvalidOperationException)
        {
            loginErrorMessage = exception.Message;
        }
        finally
        {
            selection.Password = string.Empty;
            submitting = false;
        }
    }

    private static bool IsAllowedReturnUrl(string? returnUrl)
    {
        if (string.IsNullOrWhiteSpace(returnUrl))
        {
            return false;
        }

        if (returnUrl.StartsWith("/", StringComparison.Ordinal))
        {
            return !returnUrl.StartsWith("//", StringComparison.Ordinal)
                && !returnUrl.StartsWith("/\\", StringComparison.Ordinal);
        }

        return Uri.TryCreate(returnUrl, UriKind.Absolute, out var destination)
            && destination.Scheme == Uri.UriSchemeHttp
            && string.Equals(destination.Host, "localhost", StringComparison.OrdinalIgnoreCase)
            && destination.Port is >= 8080 and <= 8085;
    }

    private string BuildReturnUrl()
    {
        if (!Uri.TryCreate(SafeReturnUrl, UriKind.Absolute, out var destination)
            || !Uri.TryCreate(Navigation.BaseUri, UriKind.Absolute, out var current)
            || destination.Authority.Equals(current.Authority, StringComparison.OrdinalIgnoreCase))
        {
            return SafeReturnUrl;
        }

        var builder = new UriBuilder(destination)
        {
            Fragment = $"campuspulse_session={Uri.EscapeDataString(JsonSerializer.Serialize(
                Authentication.CurrentSession,
                new JsonSerializerOptions(JsonSerializerDefaults.Web)))}"
        };
        return builder.Uri.ToString();
    }

    private string RoleSignInUrl(string? role)
    {
        var path = string.IsNullOrWhiteSpace(role) ? "/login" : $"/login/{role}";
        var query = IsAllowedReturnUrl(ReturnUrl)
            ? $"?returnUrl={Uri.EscapeDataString(ReturnUrl!)}"
            : string.Empty;
        return $"http://localhost:8081{path}{query}";
    }

    private async Task CreateStudentAsync()
    {
        submitting = true;
        registrationError = null;
        try
        {
            var created = await Account.CreateStudentAsync(new CampusStudentRegistration(
                studentRegistration.FirstName,
                studentRegistration.LastName,
                studentRegistration.Email,
                studentRegistration.DateOfBirth,
                studentRegistration.Password,
                studentRegistration.ConfirmPassword,
                studentRegistration.MailingAddress,
                studentRegistration.EmergencyContactName,
                studentRegistration.EmergencyContactPhone,
                studentRegistration.PhoneNumber,
                studentRegistration.Degree,
                studentRegistration.Major));
            creatingAccount = false;
            selection.AccountId = created.StudentId;
            studentRegistration.Password = string.Empty;
            studentRegistration.ConfirmPassword = string.Empty;
            accountCreatedMessage = "Account created. Continue to sign in.";
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or InvalidOperationException)
        {
            registrationError = exception.Message;
        }
        finally
        {
            submitting = false;
        }
    }

    private async Task CreateStaffAsync()
    {
        submitting = true;
        registrationError = null;
        try
        {
            var created = await Account.CreateStaffAsync(new CampusStaffRegistration(
                staffRegistration.FirstName,
                staffRegistration.LastName,
                staffRegistration.Email,
                staffRegistration.DateOfBirth,
                staffRegistration.Password,
                staffRegistration.ConfirmPassword,
                staffRegistration.PhoneNumber));
            creatingAccount = false;
            selection.AccountId = created.StaffId;
            staffRegistration.Password = string.Empty;
            staffRegistration.ConfirmPassword = string.Empty;
            accountCreatedMessage = "Account created. Continue to sign in.";
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or InvalidOperationException)
        {
            registrationError = exception.Message;
        }
        finally
        {
            submitting = false;
        }
    }

    private sealed class AccountSelection
    {
        [Required]
        public string AccountId { get; set; } = string.Empty;
        [Required]
        public string Password { get; set; } = string.Empty;
    }

    public void Dispose() => Account.Changed -= AccountChanged;

    private sealed class StudentRegistrationModel
    {
        [Required]
        public string FirstName { get; set; } = string.Empty;
        [Required]
        public string LastName { get; set; } = string.Empty;
        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;
        [Required]
        public DateOnly? DateOfBirth { get; set; }
        [Required, MinLength(12), MaxLength(128)]
        public string Password { get; set; } = string.Empty;
        [Required, Compare(nameof(Password)), MaxLength(128)]
        public string ConfirmPassword { get; set; } = string.Empty;
        [Required]
        public string MailingAddress { get; set; } = string.Empty;
        [Required]
        public string EmergencyContactName { get; set; } = string.Empty;
        [Required]
        public string EmergencyContactPhone { get; set; } = string.Empty;
        public string? PhoneNumber { get; set; }
        public string? Degree { get; set; }
        public string? Major { get; set; }
    }

    private sealed class StaffRegistrationModel
    {
        [Required]
        public string FirstName { get; set; } = string.Empty;
        [Required]
        public string LastName { get; set; } = string.Empty;
        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;
        [Required]
        public DateOnly? DateOfBirth { get; set; }
        [Required, MinLength(12), MaxLength(128)]
        public string Password { get; set; } = string.Empty;
        [Required, Compare(nameof(Password)), MaxLength(128)]
        public string ConfirmPassword { get; set; } = string.Empty;
        public string? PhoneNumber { get; set; }
    }
}
