@implements IDisposable
@inject AccountService Account
@inject NavigationManager Navigation
@inject CampusEndpoints Endpoints
@inject AuthenticationStateProvider Authentication
@inject IJSRuntime JavaScript

<div class="campus-account-menu" aria-label="Account">
    @if (Account.IsAuthenticated)
    {
        <span class="campus-account-identity">
            <strong>@(Account.CurrentUser?.FullName ?? Account.AuthenticatedEmail)</strong>
            @if (Account.CurrentUser is { } user)
            {
                <small>@user.Role · @user.ExternalId</small>
            }
        </span>
        @if (Account.CurrentUser is not null)
        {
            <a class="button button-small campus-account-control campus-account-profile" href="@ProfileUrl">Profile</a>
        }
        <button type="button" class="button button-small campus-account-control campus-account-sign-out" @onclick="SignOutAsync">Sign out</button>
    }
    else
    {
        <a class="button button-small campus-account-control campus-account-sign-in" href="@SignInUrl">Sign in</a>
    }
</div>

@code {
    private string ProfileUrl => Endpoints.AccountUrl("profile", Navigation.Uri);

    private string SignInUrl => Endpoints.AccountUrl("login", Navigation.Uri);

    protected override async Task OnInitializedAsync()
    {
        Account.Changed += AccountChanged;
        await Account.InitializeAsync();
    }

    private void AccountChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task SignOutAsync()
    {
        await Authentication.SignOutAsync();
        await Account.InitializeAsync(forceRefresh: true);
        await JavaScript.InvokeVoidAsync("campusPulseNavigation.signOutEverywhere");
    }

    public void Dispose() => Account.Changed -= AccountChanged;
}
